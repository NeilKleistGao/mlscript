class CC(val x: Int)
module CC with
  fun getX(self: CC) = self.x

:fixme // TODO: handle lifted class defs
CC(123).getX
//│ Flow: ⋅getX1
//│ ═══[RUNTIME ERROR] TypeError: CC2.getX is not a function


:breakme // TODO: warn when this happens (accidental infinite recursion)
class CC
module CC with
  fun oops(x: CC) = x.oops

:re
new CC().oops
//│ Flow: ⋅oops
//│ ═══[RUNTIME ERROR] RangeError: Maximum call stack size exceeded


class CC with
  val okay = 123
module CC with
  fun okay(x: CC) = x.okay

new CC().okay
//│ Flow: ⋅okay
//│ = 123


