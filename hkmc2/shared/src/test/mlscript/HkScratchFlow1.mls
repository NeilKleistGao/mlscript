class Foo with
  val a = 123
module Foo with
  fun foo(x: Foo) = x.a

let f = new Foo()
//│ f = Foo { a: 123 }

f.a
//│ Flow: ⋅a
//│ = 123

:e
:re
f.a.b
//│ ╔══[ERROR] Unresolved selection:
//│ ║  l.23: 	f.a.b
//│ ║        	^^^^^
//│ ╟── Type `123` does not contain member 'b'
//│ ║  l.10: 	  val a = 123
//│ ╙──      	          ^^^
//│ Flow: ⋅b
//│ ═══[RUNTIME ERROR] Error: Access to required field 'b' yielded 'undefined'

:sjs
f.foo
//│ Flow: ⋅foo
//│ JS (unsanitized):
//│ Foo1.foo(f)
//│ = 123


fun id(x) = x

id(f).foo
//│ Flow: ⋅foo1
//│ = 123


let id(x) = x
//│ id = fun id

id(f).foo
//│ Flow: ⋅foo2
//│ = 123


fun id(x) = x

id(0)
//│ Flow: @
//│ = 0

