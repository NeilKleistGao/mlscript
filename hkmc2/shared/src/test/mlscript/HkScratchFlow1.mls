module AA with
  module BB with
    class CC with
      val x: Int = 1
    module CC with
      fun getX(self: CC) = self.x

:sjs
new AA.BB.CC().x
//│ Flow: ⋅x
//│ JS (unsanitized):
//│ let tmp3; tmp3 = globalThis.Object.freeze(new AA1.BB.CC()); tmp3.x
//│ = 1

:sjs
new AA.BB.CC().getX
//│ Flow: ⋅getX
//│ JS (unsanitized):
//│ let tmp4; tmp4 = globalThis.Object.freeze(new AA1.BB.CC()); AA1.BB.CC.getX(tmp4)
//│ = 1


