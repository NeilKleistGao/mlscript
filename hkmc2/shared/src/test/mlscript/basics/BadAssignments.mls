

fun x = 1

:ge
set x = 0
//│ ╔══[COMPILATION ERROR] Cannot assign to function 'x'
//│ ║  l.3: 	fun x = 1
//│ ╙──     	^^^^^^^^^


val x = 1

:ge
set x = 0
//│ ╔══[COMPILATION ERROR] Cannot assign to value 'x'
//│ ║  l.12: 	val x = 1
//│ ╙──      	^^^^^^^^^


:ge
mut val x = 1
//│ ╔══[COMPILATION ERROR] Mutable value definitions must have an owner
//│ ║  l.22: 	mut val x = 1
//│ ╙──      	    ^^^^^^^^^

:ge
set x = 0
//│ ╔══[COMPILATION ERROR] Cannot assign to term definition 'x'
//│ ║  l.22: 	mut val x = 1
//│ ╙──      	    ^^^^^^^^^


