// * one can also go the TypeScript way

class Lit(n: Int)
class Add(lhs: Expr, rhs: Expr)

type Expr = Lit | Add


// * Which could get a "blessed" shorthand syntax as well

enum Expr =
  | Lit(n: Int)
  | Add(lhs: Expr, rhs: Expr)
