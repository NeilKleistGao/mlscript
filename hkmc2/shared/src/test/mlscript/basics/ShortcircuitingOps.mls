:sjs
1 || 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (1 === false) { return 2 } return true; 
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true

print(1 || 2)
//│ > true

1 || loudTrue
//│ = true

1 || loudFalse
//│ = true

true || loudTrue
//│ = true


123 || loud(42)
//│ = true

0 || loud(42)
//│ = true

123 && loud(42)
//│ = false

