:js


:sjs
1 && 2
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (1 === true) { return 2 } return false; 
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = false


fun
  loud(x) = print(x); x
  loudTrue = loud(true)
  loudFalse = loud(false)


true && loudTrue
//│ > true
//│ = true

true && loudFalse
//│ > false
//│ = false

false && loudTrue
//│ = false

