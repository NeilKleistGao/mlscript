fun foo(x, y) =
  let f = new Foo(x, y)
  bar(f) * baz(f)
private fun bar(f) =
  if f is
    Foo(x, y) then x + y
    else 0
private fun baz(f) =
  if f is
    Foo(x, y) then x - y
    else 1
