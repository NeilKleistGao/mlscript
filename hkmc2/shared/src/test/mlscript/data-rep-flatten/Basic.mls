fun foo(x, y) =
  let f = new Foo(x, y)
  baz(f)
fun bar(x) =
  let b = new Bar(x)
  baz(b)
private fun baz(t) =
  if t is
    Foo(x, y) then x + y
    Bar(x) then x
    else 1
