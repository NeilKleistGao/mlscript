class C(val x)
class D(val x)
class E(val x)
//│ >>> start data-rep-flatten collection-phase
//│ <<< end data-rep-flatten collection-phase
//│ >>> start data-rep-flatten transform-phase
//│ <<< end data-rep-flatten transform-phase

:ssjs
fun foo(x, y) =
  let t = new C(if y then new D(x) else new E(1))
  foofoo(t)
private fun foofoo(t) =
  if t is
    C(D(x)) then x + 1
    C(E(x)) then x - 1
