:ssjs
fun foo(x, y, z) =
  let ls = new Cons(1, new Cons(2, new Cons(3, new Cons(x, new Cons(y, new Cons(z, Nil))))))
  bar(ls)
private fun bar(ls) =
  if ls is
    Cons(1, Cons(2, Cons(3, Cons(x, Cons(y, Cons(z, Nil)))))) then x + y + z
    else -1
