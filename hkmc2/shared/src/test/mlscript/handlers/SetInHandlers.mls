//│ } finally { x = old; }
//│ return old
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ = 1
//│ x = 1


// * But `finally` is not yet supported by effect handlers

:todo
:effectHandlers
:lift
let x = 1
handle h = Object with
  fun test()(k) =
    print("SUSPENDING")
    let res = k(42)
    print("DONE")
    res
set x += 1 in
  print("init")
  print(h.test())
  print(x)
  print("end")
x
