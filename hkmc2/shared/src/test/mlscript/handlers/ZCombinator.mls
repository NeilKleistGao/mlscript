// simplified version without lambdas for easier debugging
:stackSafe 6
fun mkrec(g) =
  fun a(self) =
    fun b(y) = selfApp(self)(y)
    g(b)
  selfApp(a)

:stackSafe 6
import "../../mlscript-compile/Runtime.mls"
let fact =
  fun a(self) =
    fun b(x) =
      if x == 0 then 1 else
        let prev = self(x - 1)
        console.log("resumed:", x)
        x * prev
    b
  mkrec(a)
//│ fact = fun

:expect 3628800
:stackSafe 6
