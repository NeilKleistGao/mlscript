fun mkRange(start, end) =
  if start < end then
    mkRange(start + 1, end) :+ start
  else
    mk()

fun repeat(xs, n) = 
  if n == 0 then mk()
  else xs ++ repeat(xs, n - 1)

:expect true
repeat(xs, 512).length == xs.length * 512
//│ = true

