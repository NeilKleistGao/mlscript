:js


class C(val x, val y)
class D(val x)
class E(val x, val y)
class F(val x)
class G()
class H()

:sjs
fun check(x) =
  if x is
    C(E(_, _), F(G())) then 1
    C(D(_), D(1)) then 2
    C(D(_), F(H())) then 3
