:js

// Test: Tail-recursive function with single parameter list works correctly
fun sum(n, acc) = if n == 0 then acc else sum(n - 1, n + acc)
sum(100, 0)
//│ = 5050

// Test: Curried function with multiple parameter lists — properly lowered as
// a multi-param-list function, so the self-recursive tail call is recognized
// and optimized by TailRecOpt.
@tailrec
fun loop(x)(y) =
  if x == 0 then y
  else loop(x - 1)(y + x)
loop(1000)(0)
//│ = 500500

// Test: Function with multiple parameter lists, non-annotated (should still optimize to a loop)
:sir
fun count(start)(stop) =
  if start == stop then start
  else count(start + 1)(stop)
count(0)(100)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let count⁰, count$tailrec⁰;
//│ define count$tailrec⁰ as fun count$tailrec¹(start, stop) {
//│   loop loopLabel:
//│     let scrut, tmp;
//│     set scrut = Predef⁰.equals⁰(start, stop);
//│     match scrut
//│       true =>
//│         return start
//│       else
//│         set tmp = +⁰(start, 1);
//│         set start = tmp;
//│         continue loopLabel
//│     end
//│   end
//│ };
//│ define count⁰ as fun count¹(start)(stop) { return count$tailrec¹(start, stop) };
//│ count¹(0)(100)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 100

// Test: Mutually recursive functions with multiple parameter lists
fun even(n)(dummy) = if n == 0 then true else odd(n - 1)(dummy)
fun odd(n)(dummy) = if n == 0 then false else even(n - 1)(dummy)
even(10)(0)
//│ = true

