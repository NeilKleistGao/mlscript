:js

// Test: Tail-recursive function with single parameter list works correctly
:sjs
fun sum(n, acc) = if n == 0 then acc else sum(n - 1, n + acc)
sum(100, 0)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let sum;
//│ sum = function sum(n, acc) {
//│   loopLabel: while (true) {
//│     let scrut, tmp, tmp1;
//│     scrut = Predef.equals(n, 0);
//│     if (scrut === true) {
//│       return acc
//│     }
//│     tmp = n - 1;
//│     tmp1 = n + acc;
//│     n = tmp;
//│     acc = tmp1;
//│     continue loopLabel;
//│   }
//│ };
//│ sum(100, 0)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 5050

// Test: Curried function with multiple parameter lists — currently lowered as
// nested lambdas, so the self-recursive call through the lambda is not recognized
// as a direct tail self-call. The @tailrec annotation correctly warns about this.
:w
@tailrec
fun loop(x)(y) =
  if x == 0 then y
  else loop(x - 1)(y + x)
loop(1000)(0)
