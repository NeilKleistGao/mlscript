:js


// * Accesses to variables that were not initialized may return arbitrary values.
// * (Perhaps we should only allow this to happen when aggressive optimizations are enabled?)

// * Note: We observe the value `2` even though the branch where the assignment occurs is dead
:expect 2
:soir
let x
let y = 1
if hide(false) then
  x = 2
else
  print('hi)
hide of hide of hide of hide of hide of x // big expression so it's not folded into the `else`
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁰, y⁰;
//│ set y⁰ = 1;
//│ match false
//│   true =>
//│     set x⁰ = 2;
//│     return 2
//│   else
//│     let xs, callPrefix, tmp;
//│     set xs = mut ["hi"];
//│     set callPrefix = Rendering⁰.map﹖(Predef⁰.renderAsStr⁰);
//│     set tmp = callPrefix(...xs);
//│     do globalThis⁰.console⁰.log⁰(...tmp);
//│     return 2
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ = 2
//│ x = undefined
//│ y = 1

:expect undefined
:soir
let x
let y = 1
if hide(false) then
  x = 2
else
  print('hi)
x // folded into the `else`; no longer observe the value `2`
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x¹, y¹;
//│ set y¹ = 1;
//│ match false
//│   true =>
//│     set x¹ = 2;
//│     return 2
//│   else
//│     let xs, callPrefix, tmp;
//│     set xs = mut ["hi"];
//│     set callPrefix = Rendering⁰.map﹖(Predef⁰.renderAsStr⁰);
//│     set tmp = callPrefix(...xs);
//│     do globalThis⁰.console⁰.log⁰(...tmp);
//│     return undefined
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ x = undefined
//│ y = 1


// * Reading an uninitialized top-level variable yields undefined.
// :dopt
:soir
let x
print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x², xs⁰, callPrefix, tmp;
//│ set xs⁰ = mut [undefined];
//│ set callPrefix = Rendering⁰.map﹖(Predef⁰.renderAsStr⁰);
//│ set tmp = callPrefix(...xs⁰);
//│ return globalThis⁰.console⁰.log⁰(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > undefined
//│ x = undefined

// * Keep the uninitialized binding visible to the following block.
let x
//│ x = undefined

// :dopt
if x is 0 do print()
