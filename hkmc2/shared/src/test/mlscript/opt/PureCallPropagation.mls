:js

:inlineThreshold 100


fun foo(x)(y)(z) =
  print("hi")
  x + y + z

:soir
foo(1)(2)(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let inlinedVal; set inlinedVal = foo$worker⁰(1, 2, 3); inlinedVal
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ = 6

// The unsaturated call `foo(1)(2)` is pure, so it can be propagated
// to later call sites and combined with their remaining arguments.
:soir
let f = foo(1)(2)
print("hello")
f(3) + f(4)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰, inlinedVal, inlinedVal1;
//│ set f⁰ = foo⁰(1)(2);
//│ do Predef⁰.print⁰("hello");
//│ set inlinedVal = foo$worker⁰(1, 2, 3);
//│ set inlinedVal1 = foo$worker⁰(1, 2, 4);
//│ +⁰(inlinedVal, inlinedVal1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hello
//│ > hi
//│ > hi
//│ = 13
//│ f = fun


:soir
:inlineThreshold 10
fun foo(x)(y)(z) = x + y + z
let f = foo(1)(2) in
  print("hello")
  f(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let foo¹;
//│ define foo¹ as fun foo²(x)(y)(z) {
//│   let tmp;
//│   set tmp = +⁰(x, y);
//│   return +⁰(tmp, z)
//│ };
//│ do Predef⁰.print⁰("hello");
//│ 6
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hello
//│ = 6


