:js


// * Remove useless objects
:soir
:sjs
fun f() =
  object A
  42
f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f; f = function f() { return 42 }; return 42
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰; define f⁰ as fun f¹() { return 42 }; return 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42

// * Do not remove objects with non-trivial constructors
:soir
:sjs
fun f() =
  object A with
    print("Hello")
  42
f()
