:js


fun foo(x)(y) = 42

:soir
let f = foo(1) in f(2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


:global
:inlineThreshold 100


fun foo(x)(y)(z) =
  print("hi")
  x + y + z

:soir
let f = foo(1)(2) in
  print("hello")
  f(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Predef⁰.print⁰("hello"); do Predef⁰.print⁰("hi"); 6
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hello
//│ > hi
//│ = 6

:soir
let f = foo(1)(2)
print("hello")
f(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰; set f⁰ = foo⁰(1)(2); do Predef⁰.print⁰("hello"); do Predef⁰.print⁰("hi"); 6
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hello
//│ > hi
//│ = 6
//│ f = fun


:soir
fun foo(x)(y) =
  print("hi")
  z => 42
let f = foo(1)(2)
print("hello")
f(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let foo¹, f¹, foo$worker⁰, lambda⁰;
//│ define foo¹ as fun foo²(x)(y) {
//│   return foo$worker¹(x, y)
//│ };
//│ define foo$worker⁰ as fun foo$worker¹(x, y) {
//│   let lambda;
//│   do Predef⁰.print⁰("hi");
//│   define lambda as fun lambda¹(z) {
//│     return 42
//│   };
//│   return lambda¹
//│ };
//│ do Predef⁰.print⁰("hi");
//│ define lambda⁰ as fun lambda²(z) { return 42 };
//│ set f¹ = lambda²;
//│ do Predef⁰.print⁰("hello");
//│ 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ > hello
//│ = 42
//│ f = fun


// * The wrapper is still inlined using the alternative inlining threshold
:inlineThreshold 0
:soir
foo(1)(2)(3)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let inlinedVal; set inlinedVal = foo$worker¹(1, 2); inlinedVal(3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > hi
//│ = 42


