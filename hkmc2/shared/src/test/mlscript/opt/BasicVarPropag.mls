:js

open scope { locally }


:sir
// :dopt
:soir
let x = 1
x + 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let x⁰; set x⁰ = 1; return +⁰(x⁰, 2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁰; set x⁰ = 1; return 3
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3
//│ x = 1

// :dopt
:soir
x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return x⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


