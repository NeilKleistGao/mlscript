:soir
let x = if maybe then 1 else 1
print(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let x², scrut, tmp;
//│ set scrut = Predef⁰.maybe⁰;
//│ match scrut
//│   true =>
//│     set tmp = 1;
//│     end
//│   else
//│     set tmp = 1;
//│     end
//│ set x² = tmp;
//│ return Predef⁰.print⁰(x²)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x², xs⁰, callPrefix, tmp, inlinedVal;
//│ do Predef⁰.maybe⁰;
//│ set x² = 1;
//│ set xs⁰ = mut [1];
//│ set inlinedVal = Rendering⁰.map﹖;
//│ set callPrefix = inlinedVal(Predef⁰.renderAsStr⁰);
//│ set tmp = callPrefix(...xs⁰);
//│ return globalThis⁰.console⁰.log⁰(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1

