:js



:noOpt
:soir
let x in
  if hide(false) do
    x = 1
  print("don't inline cont.")
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x, scrut, x1, inlinedVal;
//│ set x1 = false;
//│ block inlinedLbl:
//│   set inlinedVal = x1;
//│   break inlinedLbl
//│ set scrut = inlinedVal;
//│ match scrut
//│   true =>
//│     set x = 1;
//│     end
//│ do Predef⁰.print⁰("don't inline cont.");
//│ return Predef⁰.print⁰(x)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > don't inline cont.
//│ > undefined

// * Undefined behavior (accessing uninitialized variable); behavior change is legal
// * Later, we'll catch this in the type system.
:soir
let x in
  if hide(false) do
    x = 1
  print("don't inline cont.")
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Predef⁰.print⁰("don't inline cont."); return Predef⁰.print⁰(1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > don't inline cont.
//│ > 1


:soir
let x = undefined in
  if hide(false) do
    x = 1
  print("don't inline cont.")
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x;
//│ set x = undefined;
//│ match false
//│   true =>
//│     set x = 1;
//│     end
//│ do Predef⁰.print⁰("don't inline cont.");
//│ return Predef⁰.print⁰(x)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > don't inline cont.
//│ > undefined





