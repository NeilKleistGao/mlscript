:js



:noOpt
:soir
let x in
  if hide(false) do
    x = 1
  print("don't inline cont.")
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁰, scrut;
//│ set scrut = Predef⁰.hide⁰(false);
//│ match scrut
//│   true =>
//│     set x⁰ = 1;
//│     end
//│ do Predef⁰.print⁰("don't inline cont.");
//│ return Predef⁰.print⁰(x⁰)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > don't inline cont.
//│ > undefined

// * Undefined behavior (accessing uninitialized variable); behavior change is legal
// * Later, we'll catch this in the type system.
:soir
let x in
  if hide(false) do
    x = 1
  print("don't inline cont.")
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let xs⁰, xs¹, callPrefix, tmp, callPrefix1, tmp1, inlinedVal, inlinedVal1;
//│ set xs⁰ = mut ["don't inline cont."];
//│ set inlinedVal = Rendering⁰.map﹖;
//│ set callPrefix1 = inlinedVal(Predef⁰.renderAsStr⁰);
//│ set tmp1 = callPrefix1(...xs⁰);
//│ do globalThis⁰.console⁰.log⁰(...tmp1);
//│ set xs¹ = mut [1];
//│ set inlinedVal1 = Rendering⁰.map﹖;
//│ set callPrefix = inlinedVal1(Predef⁰.renderAsStr⁰);
//│ set tmp = callPrefix(...xs¹);
//│ return globalThis⁰.console⁰.log⁰(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > don't inline cont.
//│ > 1


:soir
let x = undefined in
  if hide(false) do
    x = 1
  print("don't inline cont.")
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x¹, xs², xs³, callPrefix, tmp, callPrefix1, tmp1, inlinedVal, inlinedVal1;
//│ set x¹ = undefined;
//│ match false
//│   true =>
//│     set x¹ = 1;
//│     end
//│ set xs² = mut ["don't inline cont."];
//│ set inlinedVal = Rendering⁰.map﹖;
//│ set callPrefix1 = inlinedVal(Predef⁰.renderAsStr⁰);
//│ set tmp1 = callPrefix1(...xs²);
//│ do globalThis⁰.console⁰.log⁰(...tmp1);
//│ set xs³ = mut [x¹];
//│ set inlinedVal1 = Rendering⁰.map﹖;
//│ set callPrefix = inlinedVal1(Predef⁰.renderAsStr⁰);
//│ set tmp = callPrefix(...xs³);
//│ return globalThis⁰.console⁰.log⁰(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > don't inline cont.
//│ > undefined





