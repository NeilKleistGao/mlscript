:js


let x = hide(1)
in print(x)
//│ > 1

// :dopt
:soir
let x
in
  set x = hide(2)
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let xs⁰, callPrefix, tmp;
//│ set xs⁰ = mut [2];
//│ set callPrefix = Rendering⁰.map﹖(Predef⁰.renderAsStr⁰);
//│ set tmp = callPrefix(...xs⁰);
//│ return globalThis⁰.console⁰.log⁰(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2

:soir
let x = 1
in
  set x = hide(2)
  print(x)
  set x = hide(3)
  set x = hide(4)
  set x += 1
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let xs¹, xs², callPrefix, tmp, callPrefix1, tmp1;
//│ set xs¹ = mut [2];
//│ set callPrefix1 = Rendering⁰.map﹖(Predef⁰.renderAsStr⁰);
//│ set tmp1 = callPrefix1(...xs¹);
//│ do globalThis⁰.console⁰.log⁰(...tmp1);
//│ set xs² = mut [5];
//│ set callPrefix = Rendering⁰.map﹖(Predef⁰.renderAsStr⁰);
//│ set tmp = callPrefix(...xs²);
//│ return globalThis⁰.console⁰.log⁰(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ > 5


