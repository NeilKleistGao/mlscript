:js


let x = hide(1)
in print(x)
//│ > 1

// :dopt
:soir
let x
in
  set x = hide(2)
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ return Predef⁰.print⁰(2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2

:soir
let x = 1
in
  set x = hide(2)
  print(x)
  set x = hide(3)
  set x = hide(4)
  set x += 1
  print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ do Predef⁰.print⁰(2); return Predef⁰.print⁰(5)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ > 5


