:js


import "../../mlscript-compile/NestedFunctionsNoLift.mls"


// FIXME:
// The imported file disables lifting, so `loop` remains nested in `recursive` and must be
// discovered by replaying the imported function's body summary. Its self-edge prevents peeling.
:soir
NestedFunctionsNoLift.recursive(4)
