:js

#config(deadBranchRemoval: true)


data class C(a)
data class D(b)
data class E(c)

if true then 1 else 0
//│ = 1

// * Properly removes the `D` branch and the whole match
// :dopt
:soir
if C(123) is
  C(x) then print(x)
  D(y) then print(y)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, arg$C$0$, xs⁰, callPrefix, tmp, inlinedVal;
//│ set scrut = C⁰(123);
//│ set arg$C$0$ = scrut.a⁰;
//│ set xs⁰ = mut [arg$C$0$];
//│ set inlinedVal = Rendering⁰.map﹖;
//│ set callPrefix = inlinedVal(Predef⁰.renderAsStr⁰);
//│ set tmp = callPrefix(...xs⁰);
//│ return globalThis⁰.console⁰.log⁰(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123

// * Properly removes the `else` branch
:soir
if C(123) is
  C(x) then print(x)
  else print("?")
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, arg$C$0$, xs¹, callPrefix, tmp, inlinedVal;
//│ set scrut = C⁰(123);
//│ set arg$C$0$ = scrut.a⁰;
//│ set xs¹ = mut [arg$C$0$];
//│ set inlinedVal = Rendering⁰.map﹖;
//│ set callPrefix = inlinedVal(Predef⁰.renderAsStr⁰);
//│ set tmp = callPrefix(...xs¹);
//│ return globalThis⁰.console⁰.log⁰(...tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123

// :dopt
let c = if hide(true) then C(123) else D(456)
in if c is
  C(x) then print(x)
  else print("?")
//│ > 123

// * Properly removes the `E` branch
:soir
let c = if hide(true) then C(123) else D(456)
in if c is
  C(x) then print(x)
  D(y) then print(y)
  E(z) then print(z)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, arg$C$0$, xs², callPrefix, tmp1, inlinedVal;
//│ set tmp = C⁰(123);
//│ set arg$C$0$ = tmp.a⁰;
//│ set xs² = mut [arg$C$0$];
//│ set inlinedVal = Rendering⁰.map﹖;
//│ set callPrefix = inlinedVal(Predef⁰.renderAsStr⁰);
//│ set tmp1 = callPrefix(...xs²);
//│ return globalThis⁰.console⁰.log⁰(...tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123


