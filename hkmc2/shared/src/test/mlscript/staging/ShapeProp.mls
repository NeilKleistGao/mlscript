:js

import "../../mlscript-compile/Block.mls"
import "../../mlscript-compile/ShapeSet.mls"
import "../../mlscript-compile/ShapeMap.mls"

open Block
open ShapeSet


mkLit(0)
//│ = Lit(0)

mkDyn()
//│ = Dyn()


let arrSp = mkArr([mkLit(0), mkDyn()], false)
//│ arrSp = Arr([Lit(0), Dyn()], false)

sel(arrSp, mkLit(0))
//│ = Lit(0)

sel(arrSp, mkLit(1))
//│ = Dyn()

sel(mkDyn(), mkLit(5))
//│ = Dyn()


sop(Ctx.empty, ValueLit(42))
//│ = Lit(42)


sop(Ctx.empty, ValueLit(false))
//│ = Lit(false)


