
:js
:staging
staged module Expressions with
  fun lit() = 1
  fun assign() = 
    let x = 42
    let y = x
    y
  fun _var() =
    val x = 1
    x
  fun tup() = [1, 2]
  fun dynsel() = [1].(0)
  fun match() =
    if 9 is
      8 then 1
      9 then 2 
      Int then 3
      Bool then 4
      // [1, 2] then 5 // TODO: Case.Tup, needs handling for Label, Break
      else 0
//│ > Lit(1)
//│ > 1
//│ > Lit(42)
//│ > let x = 42
//│ > let y = x
//│ > y
//│ > Dyn
//│ > let x = undefined
//│ > let x = 1
//│ > x
//│ > Arr(Lit(1), Lit(2))
//│ > [1,2]
//│ > Lit(1)
//│ > let tmp = [1]
//│ > tmp[0]
//│ > Dyn
//│ > let scrut = 9
//│ > if scrut is
//│ > 9 then 2
//│ > Int then 3
//│ > else 0
//│ > 

:js
:staging
class Outside(val a, val b)
let x = Outside(1, 2)
staged module ClassInstrumentation with
  class Inside(a, b) // not printed correctly
  class NoArg
  fun inst1() = new Outside(1)
  fun inst2() = new NoArg
  fun match() = 
    if x is
      Outside(x, y) then 1
      else 2
//│ > class NoArg
