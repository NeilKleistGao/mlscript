:js
:staging
class Outside(a)
staged module ClassInstrumentation with
  class Inside(a, b)
  class NoArg
  fun inst1() = new Outside(1)
  fun inst2() = new NoArg
//│ > class NoArg()
//│ > 
//│ > class Inside(a, b)
//│ > 
//│ > Class(Outside, [Lit(1)])
//│ > new Outside(1)
//│ > Class(NoArg, [])
//│ > new ClassInstrumentation.NoArg()

