staged module Expressions with
  fun lit() = 1
  fun assign() = 
    let x = 42
    let y = x
    y
  fun _var() =
    val x = 1
    x
  fun tup() = [1, 2]
  fun dynsel() = [1].(0)
  fun match() =
    if 9 is
      8 then 1
      9 then 2 
      Int then 3
      Bool then 4
      // [1, 2] then 5 // TODO: Case.Tup, needs handling for Label, Break
      else 0
//│ > Lit(1)
