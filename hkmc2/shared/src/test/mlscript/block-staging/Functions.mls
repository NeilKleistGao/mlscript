class C(val a)
staged module A with
  let x = C(1)
  fun f() = set x.a = 0
  fun g() = {1 : 2}
//│ ═══[COMPILATION ERROR] Other Blocks not supported in staged module: AssignField(Ref(term:A/x,None),Ident(a),Lit(IntLit(0)),Return(Select(Ref(tmp:runtime,None),Ident(Unit)),false))
