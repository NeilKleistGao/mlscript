staged module Expressions with
  fun lit(x) = x + x
  fun assign() =
    let x = 42
    let y = x
    y
  fun tup1() = [1, 2]
  fun tup2() = 
    let x = [1, 2, 3]
    [1, x]
  fun dynsel() = [1].(0)
  fun match1() =
    if 9 is
      Bool then 1
      8 then 2
      Int then 3
      9 then 4
      else 0
  fun match2() =
    let x = [1, 2, 3]
    if x is
      [] then 1
      [1, 2] then 2
      [a, _] then 3
      else 0
