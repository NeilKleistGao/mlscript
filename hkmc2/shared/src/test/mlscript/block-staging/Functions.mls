:e
class C(val a)
staged module A with
  let x = C(1)
  fun f() = set x.a = 0
  fun g() = {1 : 2}
//│ ═══[COMPILATION ERROR] AssignField(Ref(term:A¹.x⁰,None),Ident(a),Lit(IntLit(0)),Return(Select(Ref(tmp:runtime⁰,None),Ident(Unit)),false)) is not supported yet.
