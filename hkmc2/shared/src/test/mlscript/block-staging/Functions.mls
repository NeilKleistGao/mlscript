staged module OtherBlocks with
  fun scope() =
    scope.locally of (
      let a = 1
      a
    )
  fun breakAndLabel() =
    if 1 is
      2 then 0
      3 then 0
      else 0
//│ > fun ctor_() =
//│ >   ()
