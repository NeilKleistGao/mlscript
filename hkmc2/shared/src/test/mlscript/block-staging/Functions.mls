//│ >   'Select(ValueRef(Symbol("Staged")), Symbol("f1"))' => [ [Function: f_gen], true ],
//│ >   'Select(ValueRef(Symbol("Nonstaged")), Symbol("f"))' => [ [Function: f], false ]
//│ > }

