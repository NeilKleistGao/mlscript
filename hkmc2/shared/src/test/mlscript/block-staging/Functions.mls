class Outside(a)
staged module ClassInstrumentation with
  class Inside(a, b)
  class NoArg
  fun inst1() = new Outside(1)
  fun inst2() = new NoArg
  fun app1() = Outside(1)
  fun app2() = Inside(1, 2)
//│ > class NoArg
//│ > class Inside1(a1, b)
//│ > fun ctor_() =
//│ >   
//│ > fun inst1() = return:new Outside(1)
//│ > fun inst2() = return:new ClassInstrumentation.NoArg()
//│ > fun app1() = return:Outside(1)
//│ > fun app2() = return:ClassInstrumentation.Inside1(1, 2)

