val x = [1, 2, 3]
staged module Expressions with
  fun lit(x) = x + x
  fun assign() =
    let x = 42
    let y = x
    y
  fun tup1() = [1, 2]
  fun tup2() = 
    let x = [1, 2, 3]
    [1, x]
  fun dynsel() = [1].(0)
  fun match1() =
    if 9 is
      Bool then 1
      8 then 2
      Int then 3
      9 then 4
      else 0
  fun match2() =
    let x = [1, 2, 3]
    if x is
      [] then 1
      [1, 2] then 2
      [a, _] then 3
      else 0
//│ x = [1, 2, 3]

class Outside(a)
staged module ClassInstrumentation with
  class Inside(a, b)
  class NoArg
  fun inst1() = Outside(1)
  fun app2() = Inside(1, 2) 
  fun inst2() = new NoArg
  fun app1() = Outside(1)

module Nonstaged with
  fun f() = 1
staged module Staged with
  fun f() = 1
staged module CallSubst with
  fun call() = Nonstaged.f() + Staged.f()

