//│ >   x = [1, 2, 3]
//│ >   [1, x]
//│ > fun dynsel() =
//│ >   let tmp
//│ >   tmp = [1]
//│ >   1
//│ > fun match1() =
//│ >   let scrut
//│ >   scrut = 9
//│ >   3
//│ > fun match2() =
