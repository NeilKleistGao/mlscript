//│ >     name: 'Inside',
//│ >     value: undefined,
//│ >     moduleValue: 0,
//│ >     paramsOpt: Some { value: [Array] },
//│ >     auxParams: []
//│ >   },
//│ >   'ClassSymbol("Outside", fun Outside { class: class Outside }, 0, Some([Symbol("a")]), [], _)' => ClassSymbol {
//│ >     name: 'Outside',
//│ >     value: [Function: Outside] { class: [Function] },
//│ >     moduleValue: 0,
//│ >     paramsOpt: Some { value: [Array] },
//│ >     auxParams: []
//│ >   },
//│ >   'ModuleSymbol("ClassInstrumentation", class ClassInstrumentation)' => ModuleSymbol {
//│ >     name: 'ClassInstrumentation',
