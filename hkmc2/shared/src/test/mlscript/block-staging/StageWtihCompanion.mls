:js
:staging

staged class M with
  fun f() = 1
staged module M with
  fun g() = 2
//│ > fun ctor_() = ()
//│ > fun g() = 2
//│ > Map(2) { 'ctor$' => [Function: ctor$_gen], 'g' => [Function: g_gen] }
