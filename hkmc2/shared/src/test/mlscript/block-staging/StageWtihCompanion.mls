//│ > Map(2) {
//│ >   'class$ctor$' => [Function: class$ctor$_gen],
//│ >   'f' => [Function: f_gen]
//│ > }

staged class B
module B with
  fun f() = 1
//│ > fun class_ctor_() = ()
