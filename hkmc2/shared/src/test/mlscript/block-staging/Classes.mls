import "../../mlscript-compile/Block.mls"

// TODO: copy C# annotation to Block IR
class C with
  fun call(x) = x + 1
staged module M with
  fun f(x) = x.C#call(10)
//│ > module M with
//│ >   ()
//│ >   fun f(x) = x.call(10)
//│ > Map(1) { 'f' => [Function: f_gen] }
//│ > SymbolMap {
//│ >   classMap: Map(0) {},
//│ >   moduleMap: Map(1) {
//│ >     [class M] { 'cache$M': [FunCache], 'generatorMap$M': [Map] } => ModuleSymbol { name: 'M', value: [Function] }
//│ >   }
//│ > }

staged class A(val a)
