:js
:staging

import "../../mlscript-compile/Block.mls"

// TODO: copy C# annotation to Block IR
class C with
  fun call(x) = x + 1
staged module M with
  fun f(x) = x.C#call(10)
//│ > fun ctor_() = ()
//│ > fun f(x) = x.call(10)
//│ > Map(2) { 'ctor$' => [Function: ctor$_gen], 'f' => [Function: f_gen] }

staged class A(val a)
