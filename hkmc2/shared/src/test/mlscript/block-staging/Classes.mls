//│ >   val a = a
//│ > Map(1) { 'class$ctor$' => [Function: class$ctor$_gen] }
//│ > Map(1) {
//│ >   [Function: A] {
//│ >     class: [class A] {
//│ >       'class$cache$A': [FunCache],
//│ >       'class$generatorMap$A': [Map]
//│ >     }
//│ >   } => ConcreteClassSymbol {
//│ >     name: 'A',
//│ >     value: [Function: A] { class: [Function] },
//│ >     paramsOpt: Some { value: [Array] },
//│ >     auxParams: []
//│ >   }
//│ > }

staged module C with
  class I
//│ > fun ctor_() =
//│ >   class I
