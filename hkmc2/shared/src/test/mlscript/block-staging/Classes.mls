staged class B(val x) with
  fun f(y) = this.x + y
staged class D(val x) extends B(x+1) with
  val y = 1
  fun f() = 42
//│ > fun class_ctor_(x) =
//│ >   val x = x
//│ > fun f(y) = B.x + y
//│ > Map(2) {
//│ >   'class$ctor$' => [Function: class$ctor$_gen],
//│ >   'f' => [Function: f_gen]
