staged class B(val x) with
  fun f(y) = this.x + y
staged class D(val x) extends B(x+1) with
  val y = 1
  fun f() = 42
//│ > fun ctor_(x) =
//│ >   val x = x
//│ > fun f(y) = B1.x + y
//│ > Map(2) { 'ctor$' => [Function: ctor$_gen], 'f' => [Function: f_gen] }
