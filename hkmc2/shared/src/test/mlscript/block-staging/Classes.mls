//│ >     name: 'B',
//│ >     value: [Function: B] { class: [Function] },
//│ >     paramsOpt: Some { value: [Array] },
//│ >     auxParams: []
//│ >   }
//│ > }
//│ > fun class_ctor_(x) =
//│ >   let {tmp}
//│ >   tmp = x + 1
//│ >   super(tmp)
//│ > fun f() = 42
//│ > Map(2) {
//│ >   'class$ctor$' => [Function: class$ctor$_gen],
