:js
:staging

fun f(_) = 1
class C(val x)

// :sjs
staged class D(val z) extends C([2, z + f(z)]."0") with
  val b = z + z
  fun f() = b
//│ > class D1(z) extends C([2, z + f(z)].("0")) with
//│ >   let {tmp3}
