import "../../mlscript-compile/NaiveQuery.mls"

open NaiveQuery


isGoodStudent(new Student("Foo", 100, 90, 80, 85), false)
//│ = true


isGoodStudent(new Student("Foo", 100, 60, 90, 95), false)
//│ = false


isGoodStudent(new Student("Foo", 100, 60, 98, 95), true)
//│ = true


isGoodStudent(new Student("Foo", 100, 90, 45, 95), true)
//│ = false
