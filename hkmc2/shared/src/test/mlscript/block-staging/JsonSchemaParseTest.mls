//│     )
//│   )
//│ )

parseStudentData("{'name': 'Mike', 'id': 42, 'year': 2, 'dept': 'cse'}", false)
//│ = ParseResult(17, None)

parseStudentData("{'name': 'Tom', 'id': '19821982', 'year': 1, 'dept': 'cse'}", true)
//│ = ParseResult(34, None)

parseStudentData("{'name': 'Tom', 'id': '19821982', 'gpa': 3, 'list': [{'cs': 'A', 'sc': 90}, {'cs': 'AA', 'sc': 75}]}", true)
