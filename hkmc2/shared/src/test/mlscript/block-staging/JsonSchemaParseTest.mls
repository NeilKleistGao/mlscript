:js
:staging
:noModuleCheck


import "../../mlscript-compile/JsonSchemaParser.mls"

open JsonSchemaParser

StringSchema(None, None).parse("'air'", 0)
//│ = ParseResult(5, Some("air"))

StringSchema(Some(1), Some(2)).parse("'air'", 0)
//│ = ParseResult(0, None)

StringSchema(Some(1), Some(2)).parse("'ok'", 0)
//│ = ParseResult(4, Some("ok"))


NumberSchema(None, None).parse("42", 0)
//│ = ParseResult(2, Some(42))

NumberSchema(Some(50), None).parse("42", 0)
//│ = ParseResult(0, None)

NumberSchema(None, Some(100)).parse("42", 0)
//│ = ParseResult(2, Some(42))

ArraySchema(Nil).parse("[1, 2, 3, 4]", 0)
//│ = ParseResult(12, Some(JsonArray(Cons(1, Cons(2, Cons(3, Cons(4, Nil)))))))

ArraySchema(Cons(NumberSchema(None, None), Nil)).parse("[1, 2, 3, 4]", 0)
//│ = ParseResult(12, Some(JsonArray(Cons(1, Cons(2, Cons(3, Cons(4, Nil)))))))

ArraySchema(Cons(StringSchema(None, None), Nil)).parse("[1, 2, 3, 4]", 0)
//│ = ParseResult(1, None)

ArraySchema(Cons(NumberSchema(Some(1), None), Nil)).parse("[1, 2, 3, 4]", 0)
//│ = ParseResult(12, Some(JsonArray(Cons(1, Cons(2, Cons(3, Cons(4, Nil)))))))

ArraySchema(Cons(NumberSchema(None, Some(5)), Nil)).parse("[1, 2, 3, 4, 5, 6]", 0)
//│ = ParseResult(16, None)

ArraySchema(Cons(StringSchema(None, None), Cons(NumberSchema(Some(0), Some(0)), Nil))).parse("['a', 0, 'b', 0, 'c']", 0)
//│ = ParseResult(
//│   21,
//│   Some(JsonArray(Cons("a", Cons(0, Cons("b", Cons(0, Cons("c", Nil)))))))
//│ )

ArraySchema(Cons(StringSchema(None, None), Cons(NumberSchema(Some(0), Some(0)), Nil))).parse("['a', 1, 'b', 2, 'c']", 0)
//│ = ParseResult(6, None)

ObjectSchema(Nil).parse("{'name': 'Red', 'count': 5}", 0)
//│ = ParseResult(
//│   27,
//│   Some(
//│     JsonObject(Cons(KVPair("name", "Red"), Cons(KVPair("count", 5), Nil)))
//│   )
//│ )

ObjectSchema(Cons(SchemaPair("name", StringSchema(None, None)), Cons(SchemaPair("count", NumberSchema(None, None)), Nil))).parse("{'name': 'Red', 'count': 5}", 0)
//│ = ParseResult(
//│   27,
//│   Some(
//│     JsonObject(Cons(KVPair("name", "Red"), Cons(KVPair("count", 5), Nil)))
//│   )
//│ )

ObjectSchema(Cons(SchemaPair("name", StringSchema(None, None)), Cons(SchemaPair("count", NumberSchema(None, None)), Nil))).parse("{'name': 'Red', 'count': '5'}", 0)
//│ = ParseResult(16, None)

ObjectSchema(Cons(SchemaPair("name", StringSchema(None, None)), Cons(SchemaPair("count", NumberSchema(None, None)), Cons(SchemaPair("list", ArraySchema(Nil)), Nil)))).parse("{'name': 'Red', 'count': 5, 'list': ['R', 'F', 'O', 'P', 'S']}", 0)
//│ = ParseResult(
//│   62,
//│   Some(
//│     JsonObject(
//│       Cons(
//│         KVPair("name", "Red"),
//│         Cons(
//│           KVPair("count", 5),
//│           Cons(
//│             KVPair(
//│               "list",
//│               JsonArray(
//│                 Cons("R", Cons("F", Cons("O", Cons("P", Cons("S", Nil)))))
//│               )
//│             ),
//│             Nil
//│           )
//│         )
//│       )
//│     )
//│   )
//│ )

ObjectSchema(Cons(SchemaPair("name", StringSchema(None, None)), Cons(SchemaPair("count", NumberSchema(None, None)), Cons(SchemaPair("set", ArraySchema(Nil)), Nil)))).parse("{'name': 'Red', 'count': 5, 'list': ['R', 'F', 'O', 'P', 'S']}", 0)
//│ = ParseResult(28, None)

ObjectSchema(Cons(SchemaPair("name", StringSchema(None, None)), Cons(SchemaPair("count", NumberSchema(None, None)), Cons(SchemaPair("set", ObjectSchema(Nil)), Nil)))).parse("{'name': 'Red', 'count': 5, 'set': {'R': 6, 'F': 6, 'O': 7, 'P': 8, 'S': 12}}", 0)
//│ = ParseResult(
//│   77,
//│   Some(
//│     JsonObject(
//│       Cons(
//│         KVPair("name", "Red"),
//│         Cons(
//│           KVPair("count", 5),
//│           Cons(
//│             KVPair(
//│               "set",
//│               JsonObject(
//│                 Cons(
//│                   KVPair("R", 6),
//│                   Cons(
//│                     KVPair("F", 6),
//│                     Cons(
//│                       KVPair("O", 7),
//│                       Cons(KVPair("P", 8), Cons(KVPair("S", 12), Nil))
//│                     )
//│                   )
//│                 )
//│               )
//│             ),
//│             Nil
//│           )
//│         )
//│       )
//│     )
//│   )
//│ )
