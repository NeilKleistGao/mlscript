class C(val x)

staged module Selection with
  fun f(x) =
    x.call()
    C(1).x is Bool
//│ > fun ctor_() = ()
//│ > fun f(x) =
//│ >   let {tmp, scrut}
//│ >   x.call()
//│ >   tmp = C(1)
//│ >   scrut = tmp.x
//│ >   if scrut is
//│ >     Bool then true
//│ >     else false
//│ > Map(2) { 'ctor$' => [Function: ctor$_gen], 'f' => [Function: f_gen] }
//│ > Map(2) {
//│ >   [Function: C] {
//│ >     class: [class C] { Symbol(mlscript.definitionMetadata): [Array] }
//│ >   } => ConcreteClassSymbol {
//│ >     name: 'C',
//│ >     value: [Function: C] { class: [Function] },
//│ >     paramsOpt: Some { value: [Array] },
//│ >     auxParams: []
//│ >   },
//│ >   'Bool' => VirtualClassSymbol { name: 'Bool' }
//│ > }

