:ftc
staged module M with
  fun f() = x => x
  fun g()() = 1

// TODO: these need to be printed separately, somehow:
:noModuleCheck
let x = M."f_instr"().body.rest.rhs.cls.l.value
let y = M."g_instr"().body.rest.rhs.cls.l.value
//│ x = class Function$
//│ y = class Function$

staged module Shadowing with
  fun f(x, x) = x

staged module RetUnit with
  fun f() = ()

