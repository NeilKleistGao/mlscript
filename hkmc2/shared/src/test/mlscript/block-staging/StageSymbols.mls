:js
:staging

staged module M with
  class C with
    fun f() = 1
    fun g() = f()

staged module A with
  fun f() = 1
module B with
  fun f() = 1
class C(val a, b)(c)(d)
staged module D with
  class E
  fun f() =
    A.f()
    B.f is Bool
  fun matching() =
    1 is Int
    1 is C

module A with
  module B with
    class C(a)
staged module M with
  class E
  fun f() = 
    let x = D.E
    x = A.B.C
    A.B.C(2)
    E

:e
staged module M with
  fun g()() = 1
//│ ╔══[COMPILATION ERROR] :ftc must be enabled to desugar functions with multiple parameter lists.
//│ ║  l.36: 	  fun g()() = 1
