//│ >       1 then 1
//│ >       2 then 1
//│ >       else
//│ >         n = n
//│ >         tmp2 = n - 1
//│ >         tmp3 = Test.fib(tmp2)
//│ >         tmp4 = n - 2
//│ >         tmp5 = Test.fib(tmp4)
//│ >         tmp3 + tmp5

class C(val x)

staged module TestIf with
  fun f(x) = if x is
    C(2) then "C(2)"
    C then "C"
    else "else"
  fun test() = 
    f(C(2))
    f(C(3))
    f(2)

TestIf."test_gen"()
print(TestIf."cache$TestIf")
