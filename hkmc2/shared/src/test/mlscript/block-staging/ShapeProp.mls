staged class L1() with
  fun call(x) = x + 2
staged class L2() with
  fun call(x) = x
staged class L3() with
  fun call(x) = x * 2

staged module M with
  fun twice(f, x) = f.call(f.call(x))
  fun pick(x, y, b) = if b then x else y
  fun foo(b) = 
    let y = twice(new L1(), 5)
    let m = pick(new L2(), new L3(), b)
    twice(m, 5) + y

M.foo_gen(mkDyn())
print(M."cache$M")
