//│ >   ()
//│ >   private fun f_A_sp_0() = 2
//│ > class B(val x) with
//│ >   ()
//│ >   private fun f_B_sp_0(y) = 3

staged class B(val x, val y) with
  val z = x + y

staged class D(val x, val y) extends B(x + 1, x + 2)

staged module Inheritance with
  fun test() = 
    let d = D(1, 2)
    if d is
      B then d.z
      else "not B"

Inheritance."test_gen"()
//│ = ["test", {Lit(5)}, []]

staged module NonTermination with
  fun f(x, y) = if y
    == x then 0
    else f(x, y + 1)

:re
