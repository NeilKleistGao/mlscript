fun testBinOp(op, v1, v2) =
  let args = [Arg(None, ValueLit(v1)), Arg(None, ValueLit(v2))]
  let c = Call(ValueRef(Symbol(op)), args)
  let def = DefCtx.empty
  def.add(ValueRef(Symbol("+")), undefined, false)
  def.add(ValueRef(Symbol("==")), undefined, false)
  def.add(ValueRef(Symbol("===")), undefined, false)
  def.add(ValueRef(Symbol("&&")), undefined, false)
  sor(def, Ctx.empty, c).1.lit
//│ FAILURE: Unexpected compilation error
//│ FAILURE LOCATION: newDefn (Resolver.scala:662)
//│ ╔══[COMPILATION ERROR] Expected 1 arguments, got 2
//│ ║  l.312: 	  let args = [Arg(None, ValueLit(v1)), Arg(None, ValueLit(v2))]
//│ ╙──       	                 ^^^^^^^^^^^^^^^^^^^^
//│ FAILURE: Unexpected compilation error
//│ FAILURE LOCATION: newDefn (Resolver.scala:662)
//│ ╔══[COMPILATION ERROR] Expected 1 arguments, got 2
//│ ║  l.312: 	  let args = [Arg(None, ValueLit(v1)), Arg(None, ValueLit(v2))]
//│ ╙──       	                                          ^^^^^^^^^^^^^^^^^^^^

