class C(val x)

staged module TestIf with
  fun f(x) = if x is
    C(2) then "C(2)"
    C then "C"
    else "else"
  fun test() = 
    f(C(2))
    f(C(3))
    f(2)

TestIf.test_gen()
print(TestIf."cache$TestIf")
