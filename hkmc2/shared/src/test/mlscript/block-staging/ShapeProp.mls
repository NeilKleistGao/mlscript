staged class A(val x: Int) with
  fun f(y: Int) = x + y
staged class B(val x: Int) with
  fun f(y: A) = x + y.f(x)

staged module TestThis with
  fun test2(y) = B(1).x + y // FIXME
  fun test(x) = B(x).f(A(1))

TestThis."test2_gen"(mkLit(1))
//│ = ["test2_Lit1", {Lit(2)}]

TestThis."test_gen"(mkLit(1))
print(TestThis."cache$TestThis")
//│ > module TestThis with
//│ >   ()
//│ >   fun test2_Lit1(y) = 2
//│ >   fun test_Lit1(x) = 3

print(A.class."class$cache$A")
print(B.class."class$cache$B")
