:noSanityCheck
class C(val n)
staged module TestIf2 with
  fun f2(x) =
    let y
    if x is C then
      y = x.n
    else
      y = 0
    y + 1
  fun test() = f2(C(2))
//│ > fun ctor_() =
//│ >   ()
//│ > fun f2(x) =
//│ >   let y
//│ >   let tmp
//│ >   if x is
//│ >     C(n) then
//│ >       y = x.n
//│ >       tmp = Runtime.Unit
//│ >       y + 1
//│ >     else 
//│ >       y = 0
//│ >       tmp = Runtime.Unit
//│ >       1
//│ > fun test() =
//│ >   let tmp1
//│ >   tmp1 = C(2)
//│ >   TestIf2.f2_C_Lit2(tmp1)
//│ > fun f2_C_Lit2(x) =
//│ >   let y
//│ >   let tmp
//│ >   y = 2
//│ >   tmp = Runtime.Unit
//│ >   3
//│ > Map(3) {
//│ >   'ctor$' => [Function: ctor$_gen],
//│ >   'f2' => [Function: f2_gen],
//│ >   'test' => [Function: test_gen]
