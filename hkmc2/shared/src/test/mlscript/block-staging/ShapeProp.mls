  fun call(x) = x + 2 + y
staged class L2(val y) with
  fun call(x) = x + y
staged class L3(val y) with
  fun call(x) = x * 2 + y
class L4(val y) with
  fun call(x) = x + y

staged module Test with
  fun test() = L2(1)

