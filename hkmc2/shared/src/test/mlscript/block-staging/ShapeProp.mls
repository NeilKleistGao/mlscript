// wildcard is represented as dflt in Match

filterSet(filterShapes, Block.Lit(1))
//│ = {Lit(1)}

assert(filterSet(filterShapes, Block.Lit(2)).isEmpty())

filterSet(filterShapes, Block.Cls(Symbol("A"), undefined))
//│ = {Class(ClassSymbol("A", undefined, undefined, Some(["a", "b"])), [Lit(42), Lit("c")])}

filterSet(filterShapes, Block.Cls(Symbol("Int"), undefined))
