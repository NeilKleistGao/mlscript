//│ >     let {tmp}
//│ >     tmp = y.f_A_Lit1_dot_Dyn(x)
//│ >     x + tmp

staged class B(val x, val y) with
  val z = x * y

staged class D(val x) extends B(x + 1, x + 2)

staged module M with
  fun test() = new D(1).x
  fun test2() = new D(1).y
  fun test3() = new D(1).z

M."test_gen"()
//│ = ["test", {Lit(1)}]

M."test2_gen"()
//│ = ["test2", {Lit(3)}]

M."test3_gen"()
//│ = ["test3", {Lit(6)}]
