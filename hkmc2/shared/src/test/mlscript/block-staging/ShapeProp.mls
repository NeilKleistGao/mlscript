:js
:staging
:noFreeze

module NonStaged with
  fun sq(x) = x * x

module Staged with
  fun sq(x) = x * x

staged module Test with
  fun f(x, y) = x + y + 1 - 1
  fun fib(n) = if n is 
    1 then 1
    2 then 1
    n then fib(n - 1) + fib(n - 2)
  fun pyth(x, y) = NonStaged.sq(x) + NonStaged.sq(y)
  fun pyth2(x, y) = Staged.sq(x) + Staged.sq(y)
  fun test() =
    let five = f(2, 3)
    fib(five)
    pyth(3, 4)
  fun test2(n) = 
    pyth(n, 2) 
    fib(n * 2)
