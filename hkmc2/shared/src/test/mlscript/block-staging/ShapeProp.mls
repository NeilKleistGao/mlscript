//│ >     auxParams: []
//│ >   },
//│ >   Unit {} => ModuleSymbol { name: 'Unit', value: Unit {} },
//│ >   [class TestIf2] {
//│ >     'cache$TestIf2': FunCache { cache: [Map] },
//│ >     'generatorMap$TestIf2': Map(5) {
