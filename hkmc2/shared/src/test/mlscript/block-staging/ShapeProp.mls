class C(val x)
staged module TestIf with
  fun f(x) = if x is
    C(2) then "wrong1"
    2 then "correct"
    else "wrong2"
  fun test() = 
    f(2)
//│ > fun ctor_() =
//│ >   ()
//│ > fun f(x) =
//│ >   let arg_C_0_
//│ >   if x is
//│ >     C(x1) then
//│ >       arg_C_0_ = x.x
//│ >       if arg_C_0_ is
//│ >         2 then "wrong1"
//│ >         else "wrong2"
//│ >     2 then "correct"
//│ >     else "wrong2"
//│ > fun test() = TestIf.f_Lit2(2)
//│ > fun f_Lit2(x) =
//│ >   let arg_C_0_
//│ >   "correct"
