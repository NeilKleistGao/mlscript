:noSanityCheck
class C(val n)
staged module TestIf with
  fun f(x) =
    let y
    if x is C then
      y = x.n
    else 
      y = 0
    y + 1
  fun get(n, c) = 
    c.(n)
  fun get2(n) = 
    let c = new C(3)
    c.(n)
  fun test() =
    let c = new C(2)
    f(c)
    get("n", c)
