:noSanityCheck
class C(val n)
staged module TestIf2 with
  fun f(x) =
    let y
    if x is C then
      y = x.n
    else
      y = 0
    y + 1
  fun test() = f(C(2))
  fun test2(dyn) = f(C(dyn))
  fun test3() = f(0)

TestIf2.test_gen()
TestIf2.test2_gen(mkDyn())
TestIf2.test3_gen()
print(TestIf2."cache$TestIf2")
