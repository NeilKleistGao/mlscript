//│ >     tmp10 = *(dyn, 2)
//│ >     Test.fib(tmp10)
//│ >   fun pyth_Dyn_Lit2(x, y) =
//│ >     let {tmp6, tmp7}
//│ >     tmp6 = NonStaged.sq(x)
//│ >     tmp7 = 4
//│ >     tmp6 + tmp7
//│ >   fun fib(n) =
//│ >     let {n, tmp2, tmp3, tmp4, tmp5}
