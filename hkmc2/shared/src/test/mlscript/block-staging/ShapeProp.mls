//│ >     tmp2 = new L2(2)
//│ >     tmp3 = new L3(3)
//│ >     m = M.pick_L2_Lit2_L3_Lit3_Dyn(tmp2, tmp3, b)
//│ >     M.twice_Union_L2_Lit2_L3_Lit3_end_Lit5(m, 5)
//│ >   fun twice_L1_Lit1_Lit5(f, x) =
//│ >     let {tmp}
//│ >     tmp = f.call_L1_Lit1_dot_Lit5(x)
//│ >     f.call_L1_Lit1_dot_Dyn(tmp)
//│ >   fun twice_Union_L2_Lit2_L3_Lit3_end_Lit5(f, x) =
//│ >     let {tmp}
//│ >     if f is
//│ >       L2 then
//│ >         tmp = f.call_L2_Lit2_dot_Lit5(x)
//│ >       L3 then
//│ >         tmp = f.call_L3_Lit3_dot_Lit5(x)
//│ >     if f is
//│ >       L2 then f.call_L2_Lit2_dot_Dyn(tmp)
//│ >       L3 then f.call_L3_Lit3_dot_Dyn(tmp)

print(L1.class."class$cache$L1")
print(L2.class."class$cache$L2")
print(L3.class."class$cache$L3")
