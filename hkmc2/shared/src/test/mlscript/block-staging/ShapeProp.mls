:noSanityCheck
class C(val n)
staged module TestIf2 with
  fun f(x) =
    let y
    if x is C then
      y = x.n
    else
      y = 0
    y + 1
  fun test() = f(C(2))
  fun test2(dyn) = f(C(dyn))
  fun test3() = f(0)
//│ > fun ctor_() =
//│ >   ()
//│ > fun f(x) =
//│ >   let tmp
//│ >   let y
//│ >   if x is
//│ >     C(n) then
//│ >       y = x.n
//│ >       tmp = Runtime.Unit
//│ >       y + 1
//│ >     else 
//│ >       y = 0
//│ >       tmp = Runtime.Unit
//│ >       1
//│ > fun test() = 3
//│ > fun f_C_Lit2(x) = 3
//│ > fun test2(dyn) =
//│ >   let tmp2
//│ >   tmp2 = C(dyn)
//│ >   TestIf2.f_C_Dyn(tmp2)
//│ > fun f_C_Dyn(x) =
//│ >   let tmp
//│ >   let y
//│ >   y = x.n
//│ >   tmp = Runtime.Unit
//│ >   y + 1
//│ > fun test3() = 1
//│ > fun f_Lit0(x) = 1
//│ > Map(5) {
//│ >   'ctor$' => [Function: ctor$_gen],
//│ >   'f' => [Function: f_gen],
//│ >   'test' => [Function: test_gen],
//│ >   'test2' => [Function: test2_gen],
//│ >   'test3' => [Function: test3_gen]
//│ > }
//│ > Map(3) {
//│ >   [Function: C] {
//│ >     class: [class C2] { [Symbol(mlscript.definitionMetadata)]: [Array] }
//│ >   } => ClassSymbol {
//│ >     name: 'C',
//│ >     value: [Function: C] { class: [Function] },
