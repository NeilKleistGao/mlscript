//│ >   ()
//│ >   
//│ > class B(x) with
//│ >   ()
//│ >   

staged class B(val x, val y)

staged class D(val x) extends B(x + 1, x + 2)

staged module M with
  fun test() = new D(1, 2).y
  fun test2() = new D(1, 2).x

M."test_gen"()
//│ = [Symbol("test_"), [[]]]

