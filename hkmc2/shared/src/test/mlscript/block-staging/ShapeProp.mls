staged module TestTuple with
  fun first(x) = if x is
    [a, _] then a
    else 0
  fun second(x) = if x is
    [_, b] then b
    else 0
  fun test(y) = 
    let t = [10, y]
    first(t) + second(t)

TestTuple.test_gen(mkDyn())
print(TestTuple."cache$TestTuple")
