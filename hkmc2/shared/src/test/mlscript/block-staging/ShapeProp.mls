:js
:staging
:noFreeze
:noModuleCheck
:noSanityCheck

import "../../mlscript-compile/ShapeSet.mls"
open ShapeSet
module NonStaged with
  fun sq(x) = x * x

staged module Staged with
  fun sq(x) = x * x
  fun fib(n) = if n is 
    1 then 1
    2 then 1
    n then fib(n - 1) + fib(n - 2)

staged module Test with
  fun f(x, y) = x + y + 1 - 1
  fun fib(n) = if n is
    1 then 1
    2 then 1
    n then fib(n - 1) + fib(n - 2)
  fun pyth(x, y) = NonStaged.sq(x) + NonStaged.sq(y)
  fun pyth2(x, y) = Staged.sq(x) + Staged.sq(y)
  fun test() =
    let four = f(2, 2)
    let three = fib(four)
    let two = Staged.fib(three)
    pyth(two, 4)
  fun test2(n) =
    let dyn = pyth(n, 2) 
    fib(dyn * 2)

Test."test_gen"()
Test."test2_gen"(mkDyn())
print(Test."cache$Test")
//│ > module Test with
//│ >   ()
//│ >   fun test_() =
//│ >     let {four, three, two}
//│ >     four = f(2, 2)
//│ >     three = fib(four)
//│ >     two = Staged.fib(three)
//│ >     pyth(two, 4)
//│ >   fun test2_{Dyn_28_29}(n) =
//│ >     let {dyn, tmp10}
//│ >     dyn = pyth(n, 2)
//│ >     tmp10 = *(dyn, 2)
//│ >     fib(tmp10)

class C(val x)

staged module TestIf with
  fun f(x) = if x is
    C(2) then "C(2)"
    C then "C"
    else "else"
  fun test() = 
    f(C(2))
    f(C(3))
    f(2)

TestIf."test_gen"()
print(TestIf."cache$TestIf")
//│ > module TestIf with
//│ >   ()
//│ >   fun test_() =
//│ >     let {tmp, tmp1}
//│ >     tmp = C(2)
//│ >     f(tmp)
//│ >     tmp1 = C(3)
//│ >     f(tmp1)
//│ >     f(2)

:noSanityCheck
class C(val n)
staged module TestIf2 with
  fun f(x) =
    let y
    if x is C then
      y = x.n
    else
      y = 0
    y + 1
  fun test() = f(C(2))
  fun test2(dyn) = f(C(dyn))
  fun test3() = f(0)

TestIf2."test_gen"()
TestIf2."test2_gen"(mkDyn())
TestIf2."test3_gen"()
print(TestIf2."cache$TestIf2")
//│ > module TestIf2 with
//│ >   ()
//│ >   fun test_() =
//│ >     let {tmp1}
//│ >     tmp1 = C(2)
//│ >     f(tmp1)
//│ >   fun test2_{Dyn_28_29}(dyn) =
//│ >     let {tmp2}
//│ >     tmp2 = C(dyn)
//│ >     f(tmp2)
//│ >   fun test3_() = f(0)

staged module LinearAlgebra with
  fun _dot(v1, v2, n, acc) = 
    if n ==
      v1.length then acc
      else _dot(v1, v2, n + 1, v1.(n) * v2.(n) + acc)
  fun dot(v1, v2) = _dot(v1, v2, 0, 0)
  fun test(x) = dot([x, 1, 2], [3, 4, 1])

LinearAlgebra."test_gen"(mkDyn())
print(LinearAlgebra."cache$LinearAlgebra")
//│ > module LinearAlgebra with
//│ >   ()
//│ >   fun test_{Dyn_28_29}(x) =
//│ >     let {tmp3, tmp4}
//│ >     tmp3 = [x, 1, 2]
//│ >     tmp4 = [3, 4, 1]
//│ >     dot(tmp3, tmp4)

staged class L1(val y) with
  fun call(x) = x + 2 + y
staged class L2(val y) with
  fun call(x) = x + y
staged class L3(val y) with
  fun call(x) = x * 2 + y
class L4(val y) with
  fun call(x) = x + y

staged module M with
  fun twice(f, x) = f.call(f.call(x))
  fun pick(x, y, b) = if b then x else y
  fun test(b) = 
    let y = twice(new L1(1), 5)
    let m = pick(new L2(2), new L3(3), b)
    m
    // twice(m, 5)

M."test_gen"(mkLit(true))
//│ = [Symbol("test_{Lit_28true_29}"), [[{Lit(true)}]]]

M."test_gen"(mkLit(false))
//│ = [Symbol("test_{Lit_28false_29}"), [[{Lit(false)}]]]

M."test_gen"(mkDyn())
//│ = [Symbol("test_{Dyn_28_29}"), [[{Dyn()}]]]

print(M."cache$M")
//│ > module M with
//│ >   ()
//│ >   fun test_{Lit_28true_29}(b) =
//│ >     let {y1, m, tmp1, tmp2, tmp3}
//│ >     tmp1 = new L1(1)
//│ >     y1 = twice(tmp1, 5)
//│ >     tmp2 = new L2(2)
//│ >     tmp3 = new L3(3)
//│ >     m = pick(tmp2, tmp3, b)
//│ >     m
//│ >   fun test_{Lit_28false_29}(b) =
//│ >     let {y1, m, tmp1, tmp2, tmp3}
//│ >     tmp1 = new L1(1)
//│ >     y1 = twice(tmp1, 5)
//│ >     tmp2 = new L2(2)
//│ >     tmp3 = new L3(3)
//│ >     m = pick(tmp2, tmp3, b)
//│ >     m
//│ >   fun test_{Dyn_28_29}(b) =
//│ >     let {y1, m, tmp1, tmp2, tmp3}
//│ >     tmp1 = new L1(1)
//│ >     y1 = twice(tmp1, 5)
//│ >     tmp2 = new L2(2)
//│ >     tmp3 = new L3(3)
//│ >     m = pick(tmp2, tmp3, b)
//│ >     m

print(L1.class."class$cache$L1")
print(L2.class."class$cache$L2")
print(L3.class."class$cache$L3")
