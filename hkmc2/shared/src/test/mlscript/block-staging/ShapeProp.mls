staged class B(val x, val y)

staged class D(val x, val y) extends B(x + 1, x + 2)

staged module M with
  fun test() = new D(1, 2).y
  fun test2() = new D(1, 2).x

M."test_gen"()
//│ = ["test", {Lit(2)}]

M."test2_gen"()
//│ = ["test2", {Lit(1)}]

staged class Circle(val radius) with
  fun area() = 3.14 * radius * radius 

staged class Square(val side) with
  fun area() = side * side
  
staged module TestMethodCall with
  fun pick(b) = if b then Circle(1) else Square(10)
  fun test(b) = pick(b).area()

TestMethodCall."test_gen"(mkDyn())
//│ = ["test", {Lit(100),Lit(3.14)}]

print of
  Circle.class."class$cache$Circle"
//│ > class Circle(radius) with
//│ >   val radius = radius
//│ >   fun area_Circle_Lit1_dot_() = 3.14
