open Option
open Block { Symbol, ClassSymbol, Tup, Case }
open Shape { Arr, Class, Dyn, Lit }
open ShapeSet
open SpecializeHelpers { sov }

mkBot()
//│ = {}

mkLit(0)
//│ = {Lit(0)}

mkDyn()
//│ = {Dyn()}

mkDyn() == mkDyn()
//│ = false

mkArr([mkLit(0)])
//│ = {Arr([Lit(0)])}

assert(mkBot().isEmpty())

Shape.static(Shape.Lit("Hi"))
//│ = true

// valOf

:re
valOf(Dyn())
//│ ═══[RUNTIME ERROR] Error: valOf on Dyn

valOf(Arr([Lit(1), Arr([Lit(2), Lit(3)])]))
//│ = [1, [2, 3]]

:re
valOf(mkDyn())
//│ ═══[RUNTIME ERROR] Error: Unknown shape

valOfSet(mkLit(0))
//│ = 0

// sel

let arrSp = mkArr([mkLit(0), mkDyn()])
//│ arrSp = {Arr([Lit(0), Dyn()])}

selSet(arrSp, mkLit(0))
//│ = {Lit(0)}

selSet(arrSp, mkLit(1))
//│ = {Dyn()}

selSet(mkDyn(), mkLit(5))
//│ = {Dyn()}

let a = Class(ClassSymbol("A", undefined, undefined, Some(["a", "b"]), [], undefined), [Lit(42), Lit("c")])
let x = liftMany([Dyn(), a, Arr([Lit(100), Lit(false), Lit(undefined)])])
selSet(x, liftMany([Lit("a"), Lit(2)]))
