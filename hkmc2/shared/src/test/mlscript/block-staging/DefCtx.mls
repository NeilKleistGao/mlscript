:js
:staging

fun f() = 1
staged module A with
  fun f() = 1
  fun g(x) = x
//│ > fun ctor_() =
//│ >   ()
//│ > fun f() = 1
//│ > fun g(x) = x
//│ > Map(2) { 'f' => [Function: f_gen], 'g' => [Function: g_gen] }

class C() with
  fun h() = 0

fun i() = 2

staged module B with
  fun a() = A.f()
  fun b() = C().h()
  fun c() = i()
  fun d() = A.g(1)
  fun e() = f()
//│ > fun ctor_() =
//│ >   ()
//│ > fun a() = A.f()
//│ > fun b() =
//│ >   let tmp
//│ >   tmp = C()
//│ >   tmp.h()
//│ > fun c() = i()
//│ > fun d() = A.g(1)
//│ > fun e() = f()
//│ > Map(5) {
//│ >   'a' => [Function: a_gen],
//│ >   'b' => [Function: b_gen],
//│ >   'c' => [Function: c_gen],
//│ >   'd' => [Function: d_gen],
//│ >   'e' => [Function: e_gen]
//│ > }
