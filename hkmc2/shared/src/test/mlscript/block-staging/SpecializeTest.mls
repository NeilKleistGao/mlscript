:js
:staging
:noModuleCheck
:shapeProp

import "../../mlscript-compile/ShapeSet.mls"

open ShapeSet

// :sjs
staged module M with  
  fun f(x) =
    let y = x * 2
    y
  fun f_gen
//│ > module M with
//│ >   ()
//│ >   fun f(x) =
//│ >     let {y}
//│ >     y = *(x, 2)
//│ >     y
//│ > Map(1) { 'f' => [Function: f_gen] }
//│ > SymbolMap {
//│ >   classMap: Map(0) {},
//│ >   moduleMap: Map(1) {
//│ >     [class M] { 'cache$M': [FunCache], 'generatorMap$M': [Map] } => ModuleSymbol { name: 'M', value: [Function] }
//│ >   }
//│ > }

M.f_gen(mkDyn())
//│ = [Symbol("f"), {Dyn()}]

M.f_gen(mkLit(2))
//│ = [Symbol("f_Lit2"), {Lit(4)}]

print(M."cache$M")
