:js
:staging
:noFreeze

staged module Test with
  fun f(x, y) = x + y
  fun fib(n) = if n is 
    1 then 1
    2 then 1
    n then fib(n - 1) + fib(n - 2)
  fun trig() = 
    f(2, 3)
    fib(10)
