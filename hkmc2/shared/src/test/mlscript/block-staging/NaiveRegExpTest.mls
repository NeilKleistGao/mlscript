Not(["x", "y", "z"]).match("w")
//│ = Some("w")


Star(Exact("x")).match("")
//│ = Some("")


Star(Exact("x")).match("xyz")
//│ = Some("x")


Star(Exact("x")).match("xxxy")
//│ = Some("xxx")


Star(Exact("x")).match("xxxyxxx")
//│ = Some("xxx")


Star(Any()).match("xxxyxxx")
//│ = Some("xxxyxxx")


Question(Exact("x")).match("x")
//│ = Some("x")


Question(Exact("x")).match("y")
//│ = Some("")


Question(Exact("x")).match("xx")
//│ = Some("x")


Question(Any()).match("y")
//│ = Some("y")


Union(Union(Exact("x"), Exact("y")), Exact("z")).match("z")
//│ = Some("z")


Union(Union(Exact("x"), Exact("y")), Exact("z")).match("y")
