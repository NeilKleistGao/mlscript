:js

import "../../mlscript-compile/NaiveRegExp.mls"
open NaiveRegExp


:re
RegExp().match("foo")
//│ ═══[RUNTIME ERROR] Error: Not implemented


exact("x").match("x")
//│ = Some("x")


exact("x").match("")
//│ = None


exact("x").match("xyz")
//│ = Some("x")


any.match("x")
//│ = Some("x")


any.match("")
//│ = None


any.match("xyz")
//│ = Some("x")


notOf(["x", "y", "z"]).match("xyz")
//│ = None


notOf(["x", "y", "z"]).match("w")
//│ = Some("w")


star(exact("x")).match("")
//│ = Some("")


star(exact("x")).match("xyz")
//│ = Some("x")


star(exact("x")).match("xxxy")
//│ = Some("xxx")


star(exact("x")).match("xxxyxxx")
//│ = Some("xxx")


star(any).match("xxxyxxx")
//│ = Some("xxxyxxx")


Star(exact("x"), exact("x")).match("xxxxxxx")
//│ = Some("xxxxxxx")

Star(exact("x"), exact("x")).match("x")
//│ = Some("x")

question(exact("x")).match("x")
//│ = Some("x")


question(exact("x")).match("y")
//│ = Some("")


question(exact("x")).match("xx")
//│ = Some("x")


question(any).match("y")
//│ = Some("y")


union(union(exact("x"), exact("y")), exact("z")).match("z")
//│ = Some("z")


union(union(exact("x"), exact("y")), exact("z")).match("y")
//│ = Some("y")

union(union(exact("x"), exact("y")), exact("z")).match("w")
//│ = None


// x*y
Star(exact("x"), exact("y")).match("x")
//│ = None


Star(exact("x"), exact("y")).match("y")
//│ = Some("y")


Star(exact("x"), exact("y")).match("xxxxxy")
//│ = Some("xxxxxy")


Star(exact("x"), exact("y")).match("xyyyy")
//│ = Some("xy")


// x+
plus(exact("x")).match("")
//│ = None

plus(exact("x")).match("x")
//│ = Some("x")


plus(exact("x")).match("y")
//│ = None


plus(exact("x")).match("xxx")
//│ = Some("xxx")


// x{3}, equivalent to xxx
nTimes(exact("x"), 3).match("xxx")
//│ = Some("xxx")


nTimes(exact("x"), 3).match("xxy")
//│ = None


nTimes(exact("x"), 3).match("xx")
//│ = None


:silent
let p = setOf(["T", "t"], Star(words, notWord))


matchAll(p, "To be or not to be, that is the question.")
//│ = ["To ", "t ", "to ", "that ", "the ", "tion."]


email.match("foo@bar.baz")
//│ = Some("foo@bar.baz")

email.match("foo-foo@bar.baz")
//│ = Some("foo-foo@bar.baz")

email.match("a.b.c.d@e-f.g.h")
//│ = Some("a.b.c.d@e-f.g.h")

email.match("a-b.c.d@e-f.g.h")
//│ = Some("a-b.c.d@e-f.g.h")
