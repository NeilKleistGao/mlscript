:silent
let p = Union(Concat(
  Exact(" "),
  Concat(
    Concat(Exact("t"), Star(words)),
    notWord
  )
), Concat(Question(Exact("")), Concat(
    Concat(Exact("T"), Star(words)),
    notWord
  )))


matchAll(p, "To be or not to be, that is the question.")
//│ = ["To ", " to ", " that ", " the "]


