  Exact(" "),
  Concat(
    Concat(Exact("t"), Star(w)),
    Set([Exact(" "), Exact("."), Exact(",")])
  )
), Concat(Question(Exact("")), Concat(
    Concat(Exact("T"), Star(w)),
    Set([Exact(" "), Exact("."), Exact(",")])
  ))])
