:js
:staging
:noModuleCheck


// The placement chosen at run time.
//
// `SpecialTransform3D.modelPreset(k, local)` picks between three placements
// marked `@special`.  Check each against the baseline matrix computation.
//
// Unlike the FFT plans, the three presets compute genuinely different
// transforms, so a collapsed dispatch shows up directly as a wrong answer --
// the `differ` checks below are what pin that down.

fun round6(x) =
  let y = Math.round(x * 1000000)
  if y == 0 then 0 else y / 1000000

fun show(arr) = arr.map((x, _, _) => round6(x))

fun same(a, b) = show(a).join(",") == show(b).join(",")

fun differ(a, b) = show(a).join(",") != show(b).join(",")

:silent
let p1 = [1, 2, 3]
let p2 = [-4.5, 0.25, 7]
let p3 = [0, 0, 0]


import "../../mlscript-compile/NaiveTransform3D.mls"

// Direct reference computations keep runtime selection out of the baseline.
fun modelA(local) = NaiveTransform3D.model(local, [11, 4, 51], [0.4, 0.19, 0.19], [0.8 * 3.14159265, 3.1415926535, 0.0])
fun modelB(local) = NaiveTransform3D.model(local, [-3, 7, 12], [1.5, 0.5, 2.0], [0.25 * 3.14159265, 0.0, 1.5707963268])
fun modelC(local) = NaiveTransform3D.model(local, [0, 0, 0], [1.0, 1.0, 1.0], [0.0, 0.0, 0.0])


// Preset 0 is the benchmark placement.

// The three presets really are different transforms.
differ(modelA(p1), modelB(p1))
//│ = true

differ(modelA(p1), modelC(p1))
//│ = true

differ(modelB(p1), modelC(p1))
//│ = true

// Preset 2 is the identity placement, so it returns the point unchanged.
show(modelC(p2))
//│ = [-4.5, 0.25, 7]

show(modelC(p3))
//│ = [0, 0, 0]


// ===========================================================================
// Specializing the matrix chain for the fixed benchmark placement.
// ===========================================================================

import "../../mlscript-compile/staging/Transform3D.mls"


Transform3D."generate"("../Transform3D.mls", "./hkmc2/shared/src/test/mlscript-compile/staging/out/Transform3D.mls")


import "../../mlscript-compile/staging/out/Transform3D.mls"


same(Transform3D.model(p1, [11, 4, 51], [0.4, 0.19, 0.19], [0.8 * 3.14159265, 3.1415926535, 0.0]), modelA(p1))
//│ = true

same(Transform3D.model(p2, [11, 4, 51], [0.4, 0.19, 0.19], [0.8 * 3.14159265, 3.1415926535, 0.0]), modelA(p2))
//│ = true

same(Transform3D.model(p3, [11, 4, 51], [0.4, 0.19, 0.19], [0.8 * 3.14159265, 3.1415926535, 0.0]), modelA(p3))
//│ = true

same(Transform3D.model(p2, [-3, 7, 12], [1.5, 0.5, 2.0], [0.25 * 3.14159265, 0.0, 1.5707963268]), modelB(p2))
//│ = true


// ===========================================================================
// Specializing past a placement only chosen at run time.
// ===========================================================================

import "../../mlscript-compile/staging/SpecialTransform3D.mls"


SpecialTransform3D."generate"("../SpecialTransform3D.mls", "./hkmc2/shared/src/test/mlscript-compile/staging/out/SpecialTransform3D.mls")


import "../../mlscript-compile/staging/out/SpecialTransform3D.mls"


same(SpecialTransform3D.modelPreset(0, p1), modelA(p1))
//│ = true

same(SpecialTransform3D.modelPreset(1, p1), modelB(p1))
//│ = true

same(SpecialTransform3D.modelPreset(2, p1), modelC(p1))
//│ = true

same(SpecialTransform3D.modelPreset(1, p2), modelB(p2))
//│ = true

same(SpecialTransform3D.modelPreset(2, p2), modelC(p2))
//│ = true

// A dispatch that collapsed to one preset would break these.
differ(SpecialTransform3D.modelPreset(0, p1), SpecialTransform3D.modelPreset(1, p1))
//│ = true

differ(SpecialTransform3D.modelPreset(0, p1), SpecialTransform3D.modelPreset(2, p1))
//│ = true

differ(SpecialTransform3D.modelPreset(1, p1), SpecialTransform3D.modelPreset(2, p1))
//│ = true

