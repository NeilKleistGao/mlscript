:lift
:js


:sir
class Foo with
  fun foo =
    new with
      let state = 0
      fun test =
        set state += 1
        state
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let Foo⁰, $anon⁰;
//│ define $anon⁰ as class $anon¹ {
//│   private val state⁰;
//│   constructor {
//│     super⁰();
//│     set $anon¹.this.state = 0;
//│     end
//│   }
//│   method test⁰ = fun test¹ {
//│     let tmp;
//│     set tmp = +⁰($anon¹.this.state⁰, 1);
//│     set $anon¹.this.state = tmp;
//│     return $anon¹.this.state⁰
//│   }
//│ };
//│ define Foo⁰ as class Foo¹ { method foo⁰ = fun foo¹ { return new $anon¹() } };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let f = new Foo
//│ f = Foo

let o = f.foo
//│ o = $anon

o.test
//│ = 1

:expect 2
o.test
//│ = 2

:expect 1
f.foo.test
//│ = 1


