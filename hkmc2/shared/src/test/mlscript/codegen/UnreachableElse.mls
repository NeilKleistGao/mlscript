//│   return arg$Foo$0$ + 1
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


:expect 1
foo(Foo(0))
//│ = 1


:ssjs
fun fooOrBar(x) =
  if x is
    Foo(x) then x + 1
    Bar(x) then x + 2
    else branch.unreachable
