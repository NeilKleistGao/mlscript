:js

// Test: Curried function with two parameter lists — currently lowered as
// separate calls (first call gets 1 arg list), so the function is inlined
// for the first call, then the result lambda handles the second call.
:sjs
private fun add(x)(y) = x + y
add(1)(2)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let add, x, y, inlinedVal;
//│ add = function add(x1) {
//│   return (y1) => { return x1 + y1 }
//│ };
//│ x = 1;
//│ y = 2;
//│ inlinedVal = x + y;
//│ inlinedVal
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3

// Test: Function returning a lambda, called with 2 arg lists at use site.
// Since lowering produces separate calls, this behaves like a single-param
// function that returns a lambda.
:sjs
private fun mkAdder(x) =
  (y) => x + y
mkAdder(10)(20)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let mkAdder;
//│ mkAdder = function mkAdder(x1) {
//│   let lambda;
//│   lambda = (undefined, function (y1) { return x1 + y1 });
//│   return lambda
//│ };
//│ mkAdder(10)(20)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 30

// Test: Partial application — call with fewer arg lists than param lists
:sjs
private fun add2(x)(y) = x + y
let f = add2(10)
f(5)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let add2, f, x1, inlinedVal1, inlinedLambda;
//│ add2 = function add2(x2) {
//│   return (y1) => {
//│     return x2 + y1
//│   }
//│ };
//│ x1 = 10;
//│ inlinedLambda = function inlinedLambda(y1) {
//│   inlinedVal1 = x1 + y1;
//│   return inlinedVal1
//│ };
//│ f = inlinedLambda;
//│ runtime.safeCall(f(5))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 15
//│ f = fun inlinedLambda

// Test: Three parameter lists — all correctly passed through
:sjs
private fun triple(x)(y)(z) = x + y + z
triple(1)(2)(3)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let triple;
//│ triple = function triple(x2) {
//│   return (y1) => { return (z) => { let tmp; tmp = x2 + y1; return tmp + z } }
//│ };
//│ triple(1)(2)(3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 6

// Test: Single-param function returning lambda, called with 2 arg lists
:sjs
private fun wrap(x) = (y) => x * y
wrap(3)(7)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let wrap;
//│ wrap = function wrap(x2) {
//│   let lambda;
//│   lambda = (undefined, function (y1) { return x2 * y1 });
//│   return lambda
//│ };
//│ wrap(3)(7)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 21

