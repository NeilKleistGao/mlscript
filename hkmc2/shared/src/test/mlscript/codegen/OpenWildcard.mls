:js


import "../../mlscript-compile/Option.mls"

module OtherModule with
  val None = 123


:sjs
open Option
//│ JS (unsanitized):
//│ 

:sjs
None isDefined()
//│ JS (unsanitized):
//│ Option1.isDefined(Option1.None)
//│ = false

Some(1) isDefined()
//│ = true

None === Option.None
//│ = true


fun none() = None

open OtherModule

None === Option.None
//│ = false

none() === Option.None
//│ = true


open Option
fun none() = None
console.log(None)
open OtherModule
console.log(None)
none()
//│ > None {}
//│ > 123
//│ = None


// * `open` statements are hygienic and are not affected by redefinitions

:sjs
val Option = "Oops"
//│ JS (unsanitized):
//│ let Option2; Option2 = "Oops";
//│ Option = "Oops"

:sjs
Some(123)
//│ JS (unsanitized):
//│ Option1.Some(123)
//│ = Some(123)

module Option with
  val None = 123

:sjs
open Option
//│ JS (unsanitized):
//│ 

:sjs
Some
//│ JS (unsanitized):
//│ Option1.Some
//│ = fun Some { class: class Some }

