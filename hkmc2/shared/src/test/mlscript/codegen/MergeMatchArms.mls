:js

#config(commentGeneratedCode: true)


object A
object B
object C
object D
object E


let a = A
let b = B
//│ a = A
//│ b = B

:sjs
if a is
  A then 1
  B then 2
  C then 3
  D then 4
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (a instanceof A1.class) {
//│   return 1
//│ } else if (a instanceof B1.class) {
//│   return 2
//│ } else if (a instanceof C1.class) {
//│   return 3
//│ } else if (a instanceof D1.class) {
//│   return 4
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// manually written `else if`s branches on the same scrut is also merged 
:sjs
if a is
  A then 1
  else
    if a is
      B then 2
      C then 3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (a instanceof A1.class) {
//│   return 1
//│ } else if (a instanceof B1.class) {
//│   return 2
//│ } else if (a instanceof C1.class) {
//│   return 3
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


:sjs
if a is
  A and b is
    A then 1
    B then 2
  B then 2
  C then 3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (a instanceof A1.class) {
//│   if (b instanceof A1.class) {
//│     return 1
//│   } else if (b instanceof B1.class) {
//│     return 2
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ } else if (a instanceof B1.class) {
//│   return 2
//│ } else if (a instanceof C1.class) {
//│   return 3
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2

// The match arms here are still merged because
// `let tmp = 3` is moved out so that it does not get into the way
// and `print("done")` is duplicated and moved into match arm bodies
:sjs
let x = if a is
  A then 1
  B then 2
  C then 3
  else
    let tmp = 3
    if a is
      D then
        if a is
         A then 1 + tmp
         B then 2 + tmp
      E then 5
    print("done")
print(x)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ import Rendering from "./../../mlscript-compile/Rendering.mjs";
//│ let x, tmp, xs, callPrefix, tmp1, inlinedVal;
//│ if (a instanceof A1.class) {
//│   tmp = 1;
//│ } else if (a instanceof B1.class) {
//│   tmp = 2;
//│ } else if (a instanceof C1.class) {
//│   tmp = 3;
//│ } else if (a instanceof D1.class) {
//│   let xs1, inlinedVal1, callPrefix1, tmp2, inlinedVal2;
//│   if (a instanceof A1.class) {} else if (a instanceof B1.class) {} else {
//│     throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│   }
//│   xs1 = [
//│     "done"
//│   ];
//│   inlinedVal2 = Rendering.map;
//│   callPrefix1 = runtime.safeCall(inlinedVal2(Predef.renderAsStr));
//│   tmp2 = runtime.safeCall(callPrefix1(...xs1));
//│   inlinedVal1 = runtime.safeCall(globalThis.console.log(...tmp2));
//│   tmp = inlinedVal1;
//│ } else if (a instanceof E1.class) {
//│   let xs1, inlinedVal1, callPrefix1, tmp2, inlinedVal2;
//│   xs1 = [
//│     "done"
//│   ];
//│   inlinedVal2 = Rendering.map;
//│   callPrefix1 = runtime.safeCall(inlinedVal2(Predef.renderAsStr));
//│   tmp2 = runtime.safeCall(callPrefix1(...xs1));
//│   inlinedVal1 = runtime.safeCall(globalThis.console.log(...tmp2));
//│   tmp = inlinedVal1;
//│ } else {
//│   throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│ }
//│ x = tmp;
//│ xs = [
//│   tmp
//│ ];
//│ inlinedVal = Rendering.map;
//│ callPrefix = runtime.safeCall(inlinedVal(Predef.renderAsStr));
//│ tmp1 = runtime.safeCall(callPrefix(...xs));
//│ return runtime.safeCall(globalThis.console.log(...tmp1))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1


// The match arms here are still merged because
// `let tmp = 2` is moved out so that it does not get into the way
:sjs
if a is
  A then 1
  let tmp = 2
  B then 2 + tmp
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (a instanceof A1.class) {
//│   return 1
//│ } else if (a instanceof B1.class) {
//│   return 4
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


fun printAndId(x) =
  print(x)
  x

// `let tmp = printAndId(3)` is not moved out
// because the rhs is not trivial
:sjs
if a is
  A then 1
  let tmp = printAndId(3)
  B then 2 + tmp
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (a instanceof A1.class) {
//│   return 1
//│ }
//│ {
//│   let xs1, callPrefix1, tmp2, inlinedVal1;
//│   xs1 = [
//│     3
//│   ];
//│   inlinedVal1 = Rendering.map;
//│   callPrefix1 = runtime.safeCall(inlinedVal1(Predef.renderAsStr));
//│   tmp2 = runtime.safeCall(callPrefix1(...xs1));
//│   runtime.safeCall(globalThis.console.log(...tmp2));
//│   if (a instanceof B1.class) {
//│     return 5
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// The match arms here are still merged because
// `print(x)` is duplicated and moved into match arm bodies
:sjs
if a is
  A then 1
  else
    let x = if a is
      B then 2
      C then 3
    print(x)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (a instanceof A1.class) {
//│   return 1
//│ } else if (a instanceof B1.class) {
//│   let xs1, callPrefix1, tmp2, inlinedVal1;
//│   xs1 = [
//│     2
//│   ];
//│   inlinedVal1 = Rendering.map;
//│   callPrefix1 = runtime.safeCall(inlinedVal1(Predef.renderAsStr));
//│   tmp2 = runtime.safeCall(callPrefix1(...xs1));
//│   return runtime.safeCall(globalThis.console.log(...tmp2))
//│ } else if (a instanceof C1.class) {
//│   let xs1, callPrefix1, tmp2, inlinedVal1;
//│   xs1 = [
//│     3
//│   ];
//│   inlinedVal1 = Rendering.map;
//│   callPrefix1 = runtime.safeCall(inlinedVal1(Predef.renderAsStr));
//│   tmp2 = runtime.safeCall(callPrefix1(...xs1));
//│   return runtime.safeCall(globalThis.console.log(...tmp2))
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// The match arms are not merged because
// `print(x); print(x + 1); print(x + 2)` is
// not moved into match arm bodies for being too big
:sjs
if a is
  B then 1
  else
    let x = if a is
      A then 2
      C then 3
    print(x)
    print(x + 1)
    print(x + 2)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp2, tmp3, tmp4;
//│ if (a instanceof B1.class) {
//│   return 1
//│ }
//│ {
//│   let xs1, xs2, xs3, callPrefix1, tmp5, callPrefix2, tmp6, callPrefix3, tmp7, inlinedVal1, inlinedVal2, inlinedVal3;
//│   if (a instanceof A1.class) {
//│     tmp2 = 2;
//│   } else if (a instanceof C1.class) {
//│     tmp2 = 3;
//│   } else {
//│     throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│   }
//│   xs1 = [
//│     tmp2
//│   ];
//│   inlinedVal1 = Rendering.map;
//│   callPrefix3 = runtime.safeCall(inlinedVal1(Predef.renderAsStr));
//│   tmp7 = runtime.safeCall(callPrefix3(...xs1));
//│   runtime.safeCall(globalThis.console.log(...tmp7));
//│   tmp3 = tmp2 + 1;
//│   xs2 = [
//│     tmp3
//│   ];
//│   inlinedVal2 = Rendering.map;
//│   callPrefix2 = runtime.safeCall(inlinedVal2(Predef.renderAsStr));
//│   tmp6 = runtime.safeCall(callPrefix2(...xs2));
//│   runtime.safeCall(globalThis.console.log(...tmp6));
//│   tmp4 = tmp2 + 2;
//│   xs3 = [
//│     tmp4
//│   ];
//│   inlinedVal3 = Rendering.map;
//│   callPrefix1 = runtime.safeCall(inlinedVal3(Predef.renderAsStr));
//│   tmp5 = runtime.safeCall(callPrefix1(...xs3));
//│   return runtime.safeCall(globalThis.console.log(...tmp5));
//│ }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ > 3
//│ > 4


:soir
fun f(x) =
  let acc = ""
  if x is 5 then
    return acc
  else
    if x is
      8 then print("8")
      else print("?")
    print("hi")
    acc
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰;
//│ define f⁰ as fun f¹(x) {
//│   match x
//│     5 =>
//│       return ""
//│     8 =>
//│       let xs, callPrefix, tmp, xs1, callPrefix1, tmp1, inlinedVal, inlinedVal1;
//│       set xs = mut ["8"];
//│       set inlinedVal = Rendering⁰.map﹖;
//│       set callPrefix = inlinedVal(Predef⁰.renderAsStr⁰);
//│       set tmp = callPrefix(...xs);
//│       do globalThis⁰.console⁰.log⁰(...tmp);
//│       set xs1 = mut ["hi"];
//│       set inlinedVal1 = Rendering⁰.map﹖;
//│       set callPrefix1 = inlinedVal1(Predef⁰.renderAsStr⁰);
//│       set tmp1 = callPrefix1(...xs1);
//│       do globalThis⁰.console⁰.log⁰(...tmp1);
//│       return ""
//│     else
//│       let xs, callPrefix, tmp, xs1, callPrefix1, tmp1, inlinedVal, inlinedVal1;
//│       set xs = mut ["?"];
//│       set inlinedVal = Rendering⁰.map﹖;
//│       set callPrefix = inlinedVal(Predef⁰.renderAsStr⁰);
//│       set tmp = callPrefix(...xs);
//│       do globalThis⁰.console⁰.log⁰(...tmp);
//│       set xs1 = mut ["hi"];
//│       set inlinedVal1 = Rendering⁰.map﹖;
//│       set callPrefix1 = inlinedVal1(Predef⁰.renderAsStr⁰);
//│       set tmp1 = callPrefix1(...xs1);
//│       do globalThis⁰.console⁰.log⁰(...tmp1);
//│       return ""
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(5)
//│ = ""

f(6)
//│ > ?
//│ > hi
//│ = ""

f(8)
//│ > 8
//│ > hi
//│ = ""


