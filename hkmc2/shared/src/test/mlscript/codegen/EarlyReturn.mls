//│       "whoops"
//│     ];
//│     callPrefix1 = runtime.safeCall(Predef.map(Predef.renderAsStr));
//│     tmp1 = runtime.safeCall(callPrefix1(...xs1));
//│     runtime.safeCall(globalThis.console.log(...tmp1));
//│     return 0
//│   }
//│   return x + 1;
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(1)
//│ = 2

f(-1)
//│ > whoops
//│ = 0


