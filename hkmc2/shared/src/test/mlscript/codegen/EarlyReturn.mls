:js


fun f() =
  print("--- pre ---")
  return 1
  print("--- post ---")
  

f()
//│ > --- pre ---
//│ = 1

:sjs
fun f(x) =
  if x < 0 do
    print("whoops")
    return 0
  x + 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
