//│       this.c
//│     ];
//│     callPrefix2 = runtime.safeCall(Rendering.map(Predef.renderAsStr));
//│     tmp3 = runtime.safeCall(callPrefix2(...xs2));
//│     runtime.safeCall(globalThis.console.log(...tmp3));
