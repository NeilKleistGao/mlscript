:js


let x = 0
//│ x = 0

:sjs
let x += 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let x1; x1 = x + 1; 
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ x = 1

x
//│ = 1

:sjs
set x = 0
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ x1 = 0; return runtime.Unit 
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sjs
set x += 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp; tmp = x1 + 1; x1 = tmp; return runtime.Unit 
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

x
//│ = 1


:sjs
set x += 1 in print(x)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let old, tmp1, tmp2;
//│ old = x1;
//│ try {
//│   {
//│     let xs, inlinedVal, callPrefix, tmp3;
//│     tmp2 = x1 + 1;
//│     x1 = tmp2;
//│     xs = [
//│       tmp2
//│     ];
//│     callPrefix = runtime.safeCall(Predef.map(Predef.renderAsStr));
//│     tmp3 = runtime.safeCall(callPrefix(...xs));
//│     inlinedVal = runtime.safeCall(globalThis.console.log(...tmp3));
//│     tmp1 = inlinedVal;
//│   }
//│ } finally { x1 = old; }
//│ return tmp1
//│ 
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2

x
//│ = 1


fun example() =
  let x = 0
  let get_x() = x
  let x += 1
  print(x)
  print(get_x())
example()
//│ > 1
//│ > 0

fun example() =
  let x = 0
  let get_x() = x
  set x += 1
  print(x)
  print(get_x())
example()
//│ > 1
//│ > 1

:sjs
fun example() =
  let x = 0
  let get_x() = x
  set x += 1 in print(x); print(get_x())
  print(x)
  print(get_x())
example()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let example2;
//│ example2 = function example() {
//│   let x2, get_x, old1, tmp7, tmp8, get_x1, xs4, xs5, callPrefix4, tmp9, callPrefix5, tmp10;
//│   x2 = 0;
//│   get_x1 = function get_x() {
//│     return x2
//│   };
//│   get_x = get_x1;
//│   old1 = x2;
//│   try {
//│     {
//│       let xs6, inlinedVal, xs7, callPrefix6, tmp11, callPrefix7, tmp12;
//│       tmp7 = x2 + 1;
//│       x2 = tmp7;
//│       xs6 = [
//│         x2
//│       ];
//│       callPrefix7 = runtime.safeCall(Predef.map(Predef.renderAsStr));
//│       tmp12 = runtime.safeCall(callPrefix7(...xs6));
//│       runtime.safeCall(globalThis.console.log(...tmp12));
//│       inlinedVal = x2;
//│       xs7 = [
//│         inlinedVal
//│       ];
//│       callPrefix6 = runtime.safeCall(Predef.map(Predef.renderAsStr));
//│       tmp11 = runtime.safeCall(callPrefix6(...xs7));
//│       runtime.safeCall(globalThis.console.log(...tmp11));
//│     }
//│   } finally {
//│     x2 = old1;
//│   }
//│   xs4 = [
//│     x2
//│   ];
//│   callPrefix5 = runtime.safeCall(Predef.map(Predef.renderAsStr));
//│   tmp10 = runtime.safeCall(callPrefix5(...xs4));
//│   runtime.safeCall(globalThis.console.log(...tmp10));
//│   tmp8 = runtime.safeCall(get_x());
//│   xs5 = [
//│     tmp8
//│   ];
//│   callPrefix4 = runtime.safeCall(Predef.map(Predef.renderAsStr));
//│   tmp9 = runtime.safeCall(callPrefix4(...xs5));
//│   return runtime.safeCall(globalThis.console.log(...tmp9))
//│ };
//│ return example2()
//│ 
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ > 1
//│ > 0
//│ > 0

:soir
fun example() =
  let x = 0
  let get_x() = x
  let y =
    set x += 1 in print(x); x
  print(x)
  print(get_x())
  y
example()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let example⁰;
//│ define example⁰ as fun example¹() {
//│   let x, get_x, old, tmp, tmp1, tmp2, tmp3, get_x1, xs, xs1, callPrefix, tmp4, callPrefix1, tmp5;
//│   set x = 0;
//│   @private
//│   define get_x1 as fun get_x⁰() {
//│     return x
//│   };
//│   set get_x = get_x⁰;
//│   set old = x;
//│   try
//│     let xs2, callPrefix2, tmp6;
//│     set tmp1 = +⁰(x, 1);
//│     set x = tmp1;
//│     set xs2 = mut [x];
//│     set callPrefix2 = Predef⁰.map⁰(Predef⁰.renderAsStr⁰);
//│     set tmp6 = callPrefix2(...xs2);
//│     do globalThis⁰.console⁰.log⁰(...tmp6);
//│     set tmp2 = x;
//│     set tmp = tmp2;
//│     end
//│   finally
//│     set x = old;
//│     end;
//│     set xs = mut [x];
//│   set callPrefix1 = Predef⁰.map⁰(Predef⁰.renderAsStr⁰);
//│   set tmp5 = callPrefix1(...xs);
//│   do globalThis⁰.console⁰.log⁰(...tmp5);
//│   set tmp3 = get_x();
//│   set xs1 = mut [tmp3];
//│   set callPrefix = Predef⁰.map⁰(Predef⁰.renderAsStr⁰);
//│   set tmp4 = callPrefix(...xs1);
//│   do globalThis⁰.console⁰.log⁰(...tmp4);
//│   return tmp
//│ };
//│ return example¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ > 0
//│ > 0
//│ = 1

