:sjs
fun foo(x) =
  set x = 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let foo7; foo7 = function foo(x) { x = 1; return runtime.Unit };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

print of Box(foo(1)).value
//│ > ()


