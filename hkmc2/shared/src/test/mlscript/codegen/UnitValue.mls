:sjs
print of globalThis.console.log("Hello, world!")
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp4, xs4, callPrefix4, tmp5;
//│ tmp4 = runtime.safeCall(globalThis.console.log("Hello, world!"));
//│ xs4 = [
//│   tmp4
//│ ];
//│ callPrefix4 = runtime.safeCall(Rendering.map(Predef.renderAsStr));
//│ tmp5 = runtime.safeCall(callPrefix4(...xs4));
//│ return runtime.safeCall(globalThis.console.log(...tmp5))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > Hello, world!
//│ > ()


data class Box(value)

fun foo() =
  if false do ()

print of Box(foo()).value
//│ > ()


