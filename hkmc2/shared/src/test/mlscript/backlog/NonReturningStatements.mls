:js


// TODO `fun` does not return anything; the returned value should be the result of `bar + 1`
fun foo =
  bar + 1
  fun bar = 1

foo


fun foo =
  print(bar)
  fun bar = 1

foo
//│ > 1


// TODO maybe warn that this can be confusing: one might think that `bar` is the one defined above
fun bar = 0
fun foo =
  print(bar)
  
  
  print("...")
  
  
  fun bar = 1

:sjs
foo
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let xs1, xs2, callPrefix1, tmp1, callPrefix2, tmp2;
//│ xs1 = [
//│   1
//│ ];
//│ callPrefix2 = runtime.safeCall(Rendering.map(Predef.renderAsStr));
//│ tmp2 = runtime.safeCall(callPrefix2(...xs1));
//│ runtime.safeCall(globalThis.console.log(...tmp2));
//│ xs2 = [
//│   "..."
//│ ];
//│ callPrefix1 = runtime.safeCall(Rendering.map(Predef.renderAsStr));
//│ tmp1 = runtime.safeCall(callPrefix1(...xs2));
//│ runtime.safeCall(globalThis.console.log(...tmp1));
//│ return runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ > ...


