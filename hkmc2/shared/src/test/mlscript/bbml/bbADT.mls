:bbml
//│ Type: ⊤

//│ Type: ⊤


class IntList with
  constructor Cons(x: Int, xs: IntList)
  constructor Nil()
//│ Type: ⊤


IntList.Nil()
//│ Type: IntList

IntList.Cons(1, IntList.Cons(2, IntList.Nil()))
//│ Type: IntList


:e
class Bad with
  constructor Foo(42)
//│ ╔══[ERROR] Illegal ADT parameter shape.
//│ ║  l.22: 	  constructor Foo(42)
//│ ╙──      	              ^^^^^^^
//│ Type: ⊤


class Empty with
  constructor Foo
//│ Type: ⊤


:e
class BadBad with
  constructor 42
//│ ╔══[ERROR] Constructor parameter list is required.
//│ ║  l.36: 	  constructor 42
//│ ╙──      	              ^^
//│ Type: ⊤


class Maybe[T] with
  constructor Just(v: T)
  constructor Nothing()
//│ Type: ⊤


Maybe.Nothing()
//│ Type: Maybe['T]


Maybe.Nothing(): Maybe[out Int]
//│ Type: Maybe[out Int]


Maybe.Just(42)
//│ Type: Maybe['T]
//│ Where:
//│   Int <: 'T


Maybe.Just(true)
//│ Type: Maybe['T]
//│ Where:
//│   Bool <: 'T


class SimpleCode[T] with
  constructor IntLit(v: Int) { T = Int }
  constructor NumLit(v: Num) { T = Num }
  constructor Eq[S](lhs: SimpleCode[S], rhs: SimpleCode[S]) { T = Bool }
//│ Type: ⊤


SimpleCode.IntLit(42)
//│ Type: SimpleCode['T]
//│ Where:
//│   Int <: 'T
//│   'T <: Int


:e
SimpleCode.IntLit(false)
//│ ╔══[ERROR] Type error in boolean literal with expected type Int
//│ ╙── because: cannot constrain  Bool  <:  Int
//│ Type: SimpleCode['T]
//│ Where:
//│   Int <: 'T
//│   'T <: Int


let lhs = SimpleCode.IntLit(0)
let rhs = SimpleCode.IntLit(1)
let pi = SimpleCode.NumLit(3.14)
//│ Type: ⊤


SimpleCode.Eq(lhs, rhs)
//│ Type: SimpleCode['T]
//│ Where:
//│   Bool <: 'T
//│   'T <: Bool


:e
SimpleCode.Eq(lhs, pi)
//│ ╔══[ERROR] Type error in reference with expected type SimpleCode['S]
