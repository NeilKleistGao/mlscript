fun sum(xs) =
  if xs is
    IntList.Cons(x, rest) then x + sum(rest)
    IntList.Nil() then 0
sum
//│ Type: IntList -> Int


sum(IntList.Cons(1, IntList.Cons(2, IntList.Nil())))
//│ Type: Int


