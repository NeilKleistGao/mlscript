:bbml
//│ Type: ⊤

//│ Type: ⊤


class IntList with
  constructor Cons(x: Int, xs: IntList)
  constructor Nil()
//│ Type: ⊤


IntList.Nil()
//│ Type: IntList

IntList.Cons(1, IntList.Cons(2, IntList.Nil()))
//│ Type: IntList


:e
