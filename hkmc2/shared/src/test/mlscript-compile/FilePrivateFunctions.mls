import "./Predef.mls"

open annotations { noInline }

@noInline fun inaccessibleFunction() = "It works."

module FilePrivateFunctions with
  fun accessibleFunction1() =
    Predef.print(inaccessibleFunction())
    "Okay?"
  fun accessibleFunction2() =
    inaccessibleFunction() + "Okay!"
  @noInline fun noInlineFunction() =
    "This function should not be inlined."
  fun selfRecursive(n) =
    if n <= 0 then 0 else selfRecursive(n - 1) + 1
  fun mutuallyRecursiveEven(n) =
    if n <= 0 then true else mutuallyRecursiveOdd(n - 1)
  fun mutuallyRecursiveOdd(n) =
    if n <= 0 then false else mutuallyRecursiveEven(n - 1)
