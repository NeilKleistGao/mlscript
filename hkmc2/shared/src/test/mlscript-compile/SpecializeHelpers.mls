import "./Block.mls"
import "./Shape.mls"
import "./Option.mls"

open Block
open Shape
open Option

module SpecializeHelpers with ...

// FIXME: implement proper mangling
// percent encoding to create valid symbol name
fun specializeName(funName, shapes) =
  [... funName + "_" + shapes.toString()]
    .map((s, _, _) => if s is
      "[" then "_5b"
      "]" then "_5d"
      "(" then "_28"
      ")" then "_29"
      "\\" then "_5c"
      "\"" then "_22"
      " " then "_20"
      "," then "_2c"
      else s
    ).join("")
fun propStub(block, shapes) = [block, Dyn()]

