#config(noFreeze: true)

open annotations { special, specialize }

module SeqHelper with
  fun has(arr, ele) = arr.includes(ele)
  fun len(s) = s.length

staged module SpecialRegExpSimple with
  class Some(val x)
  class None

  class Cons(val x, val xs)
  class Nil

  @specialize
  fun pushUnique(ls, e) =
    if ls is
      Cons(x, xs) then
        if x.eq(e) then ls
        else (@special new Cons(x, pushUnique(xs, e)))
      else (@special new Cons(e, Nil))

  fun concatUnique(xs, ys) =
    if ys is
      Cons(y, ys') then concatUnique(pushUnique(xs, y), ys')
      else xs

  @specialize
  fun lsEq(xs, ys) =
    if [xs, ys] is
      [Nil, Nil] then true
      [Cons(x, xs), Cons(y, ys)] then x.eq(y) and lsEq(xs, ys)
      else false

  fun has(arr, ele) = SeqHelper.has(arr, ele)

  staged class RegExp() with
    fun derive(c)
    fun canBeEmpty()
    fun normalize()
    fun eq(other)
    fun startsWith(c)
    fun flat()

  staged class Nothing() extends RegExp() with
    fun derive(c) = this
    fun canBeEmpty() = false
    fun normalize() = this
    fun eq(other) = other is Nothing
    fun startsWith(c) = false
    fun flat() = new Nil

  staged class Empty() extends RegExp() with
    fun derive(c) = new Nothing()
    fun canBeEmpty() = true
    fun normalize() = this
    fun eq(other) = other is Empty
    fun startsWith(c) = false
    fun flat() = (@special new Cons(this, Nil))

  staged class Exact(val ch) extends RegExp() with
    fun derive(c) =
      if startsWith(c) then new Empty()
      else new Nothing()
    fun canBeEmpty() = false
    fun normalize() = this
    fun eq(other) =
      if other is Exact(ch') then ch == ch' else false
    fun startsWith(c) = ch == c
    fun flat() = (@special new Cons(this, Nil))

  @specialize
  fun mkUnion(ls) =
    if ls is
      Cons(x, Nil) then x
      Cons(x, xs) then (@special new Altern(x, mkUnion(xs)))
      else new Nothing()

  staged class Altern(val p1, val p2) extends RegExp() with
    fun derive(c) = (@special new Altern(p1.derive(c), p2.derive(c))).normalize()
    fun canBeEmpty() = p1.canBeEmpty() || p2.canBeEmpty()
    fun normalize() =
      mkUnion(flat())
    fun eq(other) =
      if other is
        Altern then lsEq(flat(), other.flat())
        else false
    fun startsWith(c) = p1.startsWith(c) || p2.startsWith(c)
    fun flat() =
      let p1' = p1.flat()
      let p2' = p2.flat()
      concatUnique(concatUnique(Nil, p1'), p2')

  staged class Concat(val p1, val p2) extends RegExp() with
    fun derive(c) =
      let p1' = p1.derive(c)
      if p1.canBeEmpty() then
        let t = (@special new Concat(p1', p2)).normalize()
        (@special new Altern(t, p2.derive(c))).normalize()
      else (@special new Concat(p1', p2)).normalize()
    fun canBeEmpty() = p1.canBeEmpty() and p2.canBeEmpty()
    fun normalize() =
      let p1' = p1.normalize()
      if p1' is
        Empty() then p2.normalize()
        Nothing() then p1'
        else (@special new Concat(p1', p2.normalize()))
    fun eq(other) =
      if other is Concat(p1', p2') then p1.eq(p1') and p2.eq(p2') else false
    fun startsWith(c) = p1.startsWith(c) || (p1.canBeEmpty() and p2.startsWith(c))
    fun flat() = (@special new Cons(this, Nil))

  staged class Star(val p) extends RegExp() with
    fun derive(c) = (@special new Concat(p.derive(c), (@special new Star(p)))).normalize()
    fun canBeEmpty() = true
    fun normalize() = (@special new Star(p.normalize()))
    fun eq(other) =
      if other is Star(p') then p.eq(p') else false
    fun startsWith(c) = p.startsWith(c)
    fun flat() = (@special new Cons(this, Nil))

  @specialize fun matchImpl(p, s, acc) = if
    SeqHelper.len(s) == 0 and
      p.canBeEmpty() then new Some(acc)
      else new None
    p is Nothing then new None
    let c = s.0
    p.startsWith(c) then matchImpl(p.derive(c), s.slice(1), acc + c)
    p.canBeEmpty() then new Some(acc)
    else new None
  fun match(p, s) =
    matchImpl(p, s, "")

  fun test(s) =
    let p = new Concat(new Star(new Exact("a")), new Exact("b"))
    match(p, s)
