  fun matchImpl(p, s, acc) =
    if s.length === 0 then
      if p.canBeEmpty() then new Some(acc)
      else new None
    else
      let c = s.0
      if p.derive(c) is
        Some(p') then
          matchImpl(p', s.slice(1), acc + c)
        None then
          if p.canBeEmpty() then new Some(acc) else None
        else new None
  fun match(p, s) =
    matchImpl(p, s, "")

