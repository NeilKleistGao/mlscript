      fun f(x, y) = x + y
      fun f_Lit2_Lit3(x, y) = 5
      fun fib(n) =
        let {n1, tmp, tmp1, tmp2, tmp3}
        if n is
          1 then 1
          2 then 1
          else
            n1 = n
            tmp = n1 - 1
            tmp1 = fib(tmp)
            tmp2 = n1 - 2
            tmp3 = fib(tmp2)
            tmp1 + tmp3
      fun fib_Lit1(n) = 1
      fun fib_Lit10(n) = 55
      fun fib_Lit2(n) = 1
      fun fib_Lit3(n) = 2
      fun fib_Lit4(n) = 3
