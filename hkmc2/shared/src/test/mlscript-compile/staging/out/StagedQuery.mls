  fun filterGoodStudents(students, spec) =
    let {pred2, tmp6, tmp7, tmp8, tmp9, tmp10, tmp11, tmp12, tmp13, tmp14, tmp15, tmp16, tmp17, tmp18}
    if spec is
      true then
        tmp6 = new GreaterEqThan(80, "mathGrade")
        tmp7 = new GreaterEqThan(80, "engGrade")
        tmp8 = new And(tmp6, tmp7)
        tmp9 = new GreaterThan(95, "physGrade")
        tmp10 = new GreaterThan(95, "chemGrade")
        tmp11 = new And(tmp9, tmp10)
        tmp12 = new And(tmp8, tmp11)
      else
        tmp13 = new GreaterEqThan(90, "mathGrade")
        tmp14 = new GreaterEqThan(90, "engGrade")
        tmp15 = new And(tmp13, tmp14)
        tmp16 = new GreaterEqThan(90, "physGrade")
        tmp17 = new GreaterEqThan(90, "chemGrade")
        tmp18 = new And(tmp16, tmp17)
        tmp12 = new And(tmp15, tmp18)
    pred2 = tmp12
    filter_StagedQuery_sp_0(students, pred2)
  fun filterImpl(arr, pred, res) =
    let {scrut2, tmp3, tmp4}
    if arr is
      [] then res
      else
        tmp3 = StagedQuery__Legacy."SeqHelper$StagedQuery".tail(arr)
        scrut2 = pred.test(arr.0)
        if scrut2 is
          true then
            tmp4 = StagedQuery__Legacy."SeqHelper$StagedQuery".pushDyn(res, arr.0)
            filterImpl(tmp3, pred, tmp4)
          else
            tmp4 = res
            filterImpl(tmp3, pred, tmp4)
fun test_GreaterEqThan_sp_0(self, obj) = obj.(self.field) >= self.v
fun test_GreaterEqThan_sp_1(self, obj) = obj.(self.field) >= self.v
fun test_And_sp_0(self, obj) =
  let {scrut, scrut1}
  scrut = test_And_sp_1(self.lhs, obj)
  if scrut is
    true then
      scrut1 = self.rhs.test(obj)
      if scrut1 is
        true then true
        else false
    else false
fun test_And_sp_1(self, obj) =
  let {scrut, scrut1}
  scrut = test_GreaterEqThan_sp_0(self.lhs, obj)
  if scrut is
    true then
      scrut1 = test_GreaterEqThan_sp_1(self.rhs, obj)
      if scrut1 is
        true then true
        else false
    else false
