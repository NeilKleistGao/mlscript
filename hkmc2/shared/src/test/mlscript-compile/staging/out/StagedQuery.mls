import "../StagedQuery.mls" as StagedQuery__Legacy
module StagedQuery with
  class Student(val name, val mathGrade, val physGrade, val chemGrade, val engGrade)
  class Pred with
    ()
  class GreaterThan(val v, val field) extends Pred() with
    ()
    fun test(obj) = obj.(field) > v
  class GreaterEqThan(val v, val field) extends Pred() with
    ()
    fun test(obj) = obj.(field) >= v
  class LessThan(val v, val field) extends Pred() with
    ()
    fun test(obj) = obj.(field) < v
  class LessEqThan(val v, val field) extends Pred() with
    ()
    fun test(obj) = obj.(field) <= v
  class Eq(val v, val field) extends Pred() with
    ()
    fun test(obj) = obj.(field) == v
  class NotEq(val v, val field) extends Pred() with
    ()
    fun test(obj) =
      let {tmp}
      tmp = obj.(field) == v
      not tmp
  class And(val lhs, val rhs) extends Pred() with
    ()
    fun test(obj) =
      let {scrut, scrut1}
      scrut = lhs.test(obj)
      if scrut is
        true then
          scrut1 = rhs.test(obj)
          if scrut1 is
            true then true
            else false
        else false
  class Or(val lhs, val rhs) extends Pred() with
    ()
    fun test(obj) =
      let {tmp1}
      tmp1 = lhs.test(obj)
      if tmp1 is
        false then rhs.test(obj)
        else true
  class Not(val e) extends Pred() with
    ()
    fun test(obj) =
      let {tmp2}
      tmp2 = e.test(obj)
      not tmp2
