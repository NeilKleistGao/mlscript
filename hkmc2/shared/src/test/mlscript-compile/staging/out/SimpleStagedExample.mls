module SimpleStagedExample with
  ()
  fun ctor_() = ()
  fun f(x, y) = x + y
  fun fib(n) =
    let {tmp, tmp1, tmp2, tmp3, n1}
    if n is
      1 then 1
      2 then 1
      else
        n1 = n
        tmp = n1 - 1
        tmp1 = SimpleStagedExample.fib(tmp)
        tmp2 = n1 - 2
        tmp3 = SimpleStagedExample.fib(tmp2)
        tmp1 + tmp3
  fun foo() =
    let {tmp4, tmp5}
    tmp4 = SimpleStagedExample.f_Lit2_Lit3(2, 3)
    tmp5 = SimpleStagedExample.fib_Lit10(10)
    60
