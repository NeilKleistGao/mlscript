#config(noFreeze: true, noModuleCheck: true, deadParamElim: Some(DeadParamElim(debug: false, mono: true)))
import "../SimpleStagedExample.mls"
module SimpleStagedExample with
    class Bar(x) with
      ()
      fun bar() = x
      private fun bar_Bar_Lit1_dot_() = 1
    class Foo(x) with
      ()
      fun foo(b) =
        let {tmp, tmp1}
        if b is
          1 then
            tmp = x.bar()
            tmp + 1
          2 then
            tmp1 = x.bar()
            tmp1 + 2
          else x.bar()
      private fun foo_Foo_Bar_Lit1_dot_Lit1() = 2
    fun baz() = 2
    fun f(x, y) = x + y
    fun fib(n) =
      let {n1, tmp2, tmp3, tmp4, tmp5}
      if n is
        1 then 1
        2 then 1
        else
          n1 = n
          tmp2 = n1 - 1
          tmp3 = fib(tmp2)
          tmp4 = n1 - 2
          tmp5 = fib(tmp4)
          tmp3 + tmp5
    fun foo() = 60
    fun foobar(x) =
      let {y1, z, tmp10, tmp11}
      if x is
        0 then
          tmp10 = 1
        else
          tmp10 = 0
      y1 = tmp10
      tmp11 = 0
      z = 0
      y1 + 0
    fun spaces() =
      let {tup_1}
      tup_1 = ["\t", "\n", "\r"]
      tup_1
    private fun f_Lit2_Lit3() = 5
    private fun fib_Lit1() = 1
    private fun fib_Lit10() = 55
    private fun fib_Lit2() = 1
    private fun fib_Lit3() = 2
    private fun fib_Lit4() = 3
    private fun fib_Lit5() = 5
    private fun fib_Lit6() = 8
    private fun fib_Lit7() = 13
