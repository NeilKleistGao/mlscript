#config(noFreeze: true)
#config(noModuleCheck: true)
import "../SimpleStagedExample.mjs"
module SimpleStagedExample with
    class Bar(x) with
      ()
      fun bar() = x
      fun bar_Bar_Lit1_dot_() = 1
    class Foo(x) with
      ()
      fun foo(b) =
        let {tmp, tmp1}
        if b is
          1 then
            tmp = x.bar()
            tmp + 1
          2 then
            tmp1 = x.bar()
            tmp1 + 2
          else x.bar()
      fun foo_Foo_Bar_Lit1_dot_Lit1(b) = 2
    fun baz() = 2
    fun f(x, y) = x + y
    fun f_Lit2_Lit3(x, y) = 5
    fun fib(n) =
      let {n1, tmp2, tmp3, tmp4, tmp5}
      if n is
        1 then 1
        2 then 1
        else
          n1 = n
          tmp2 = n1 - 1
          tmp3 = fib(tmp2)
          tmp4 = n1 - 2
          tmp5 = fib(tmp4)
          tmp3 + tmp5
    fun fib_Lit1(n) = 1
    fun fib_Lit10(n) = 55
    fun fib_Lit2(n) = 1
    fun fib_Lit3(n) = 2
    fun fib_Lit4(n) = 3
