import "../SimpleStagedExample.mls"
open SimpleStagedExample
module SimpleStagedExample with
  ()
  fun ctor() = ()
  fun f(x, y) = x + y
  fun fib(n) =
    let {tmp, tmp1, tmp2, tmp3, n1}
    if n is
      1 then 1
      2 then 1
      else
        n1 = n
        tmp = n1 - 1
        tmp1 = SimpleStagedExample.fib(tmp)
        tmp2 = n1 - 2
        tmp3 = SimpleStagedExample.fib(tmp2)
        tmp1 + tmp3
  fun foo() = 60
  fun f_Lit2_Lit3(x, y) = 5
  fun fib_Lit10(n) = 55
  fun fib_Lit9(n) = 34
  fun fib_Lit8(n) = 21
  fun fib_Lit7(n) = 13
  fun fib_Lit6(n) = 8
  fun fib_Lit5(n) = 5
  fun fib_Lit4(n) = 3
  fun fib_Lit3(n) = 2
  fun fib_Lit2(n) = 1
  fun fib_Lit1(n) = 1