#config(noFreeze: true, noModuleCheck: true, deadParamElim: Some(DeadParamElim(debug: false, mono: true)))
import "../StagedRegExp.mls"
module StagedRegExp with
    class Some(val x)
    class None
    class RegExp() with
      ()
    class Empty() extends StagedRegExp.RegExp() with
      ()
      fun canBeEmpty() = true
      fun derive(c) =
        let {obj_1}
        obj_1 = new! None
        obj_1
    class Exact(val ch) extends StagedRegExp.RegExp() with
      ()
      fun canBeEmpty() = false
      fun derive(c) =
        let {scrut, tmp}
        scrut = ===(ch, c)
        if scrut is
          true then
            tmp = new StagedRegExp.Empty
            new StagedRegExp.Some(tmp)
          else new StagedRegExp.None
    fun match(p, s) = matchImpl_Dyn_Dyn_Str_empty(p, s, "")
    fun matchImpl(p, s, acc) =
      let {scrut1, scrut2, c2, scrut3, p__, scrut4, arg_Some_0_, tmp1, tmp2}
      scrut1 = ===(s.length, 0)
      if scrut1 is
        true then
          scrut2 = p.canBeEmpty()
          if scrut2 is
            true then new Some(acc)
            else new None
        else
          c2 = s.0
          scrut3 = p.derive(c2)
          if scrut3 is
            Some then
              arg_Some_0_ = scrut3.x
              p__ = arg_Some_0_
              tmp1 = s.slice(1)
              tmp2 = acc + c2
              matchImpl(p__, tmp1, tmp2)
            None then
              scrut4 = p.canBeEmpty()
              if scrut4 is
                true then new Some(acc)
                else None
            else new None
    private fun matchImpl_Dyn_Dyn_Str_empty(p, s, acc) =
      let {scrut1, scrut2, c2, scrut3, p__, scrut4, arg_Some_0_, tmp1, tmp2}
      scrut1 = ===(s.length, 0)
      if scrut1 is
        true then
          scrut2 = p.canBeEmpty()
          if scrut2 is
            true then new Some(acc)
            else new None
        else
          c2 = s.0
          scrut3 = p.derive(c2)
          console.log(scrut3)
          if scrut3 is
            Some then
              console.log("?")
              arg_Some_0_ = scrut3.x
              p__ = arg_Some_0_
              tmp1 = s.slice(1)
              tmp2 = "" + c2
              matchImpl(p__, tmp1, tmp2)
            None then
              scrut4 = p.canBeEmpty()
              if scrut4 is
                true then new Some(acc)
                else None
            else new None