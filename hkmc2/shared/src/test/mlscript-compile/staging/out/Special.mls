#config(noFreeze: true, noModuleCheck: true, liftDefns: None, disableDataFlowAnalysis: true, deadParamElim: Some(DeadParamElim(debug: false, mono: true)))
import "../Special.mls" as Special__Legacy
module Special with
    class Pair(val x, val y) with
      ()
      fun swap() = new Pair.class(y, x)
    fun bar(b) =
      let {x2, tmp3, tmp4, tmp5}
      if b is
        true then
          tmp3 = new Pair(1, 2)
        else
          tmp3 = new Pair(3, 4)
      x2 = tmp3
      tmp4 = swap_Pair_sp_0(x2)
      tmp5 = sub_Special_sp_0(tmp4)
      tmp5 > 0
    fun f() = new Pair(1, 2)
    fun foo(b) =
      let {x1, tmp, tmp1, tmp2}
      if b is
        true then
          tmp = new Pair(1, 2)
        else
          tmp = new Pair(3, 4)
      x1 = tmp
      tmp1 = swap_Pair_sp_0(x1)
      tmp2 = sub_Special_sp_0(tmp1)
      tmp2 > 0
    fun g(p) = sub(p)
    fun sub(p) = p.x - p.y
open Special
fun sub_Special_sp_0(p) = p.x - p.y
fun swap_Pair_sp_0(self) = new Pair.class(self.y, self.x)