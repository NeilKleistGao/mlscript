        true then Baz(1)
        else new Baz(2)
    fun f(x) =
      let {x__, y1, arg_Baz_0_, arg_Bar_0_}
      if x is
        Foo then 0
        Bar then
          arg_Bar_0_ = x.x
          x__ = arg_Bar_0_
          x__
        Baz then
          arg_Baz_0_ = x.x
          y1 = arg_Baz_0_
          y1 + 1
