#config(noFreeze: true)

open annotations { special, specialize }

// Sparse matrix kernels over a CSR-like pattern, specialized on the pattern
// even when which pattern is used is only decided at run time.
//
// `StagedSparseTensor.mls` unrolls an entry point that names one pattern, but
// its `spmvStencil` picks among several and so gets nothing: the pattern it
// passes to `spmv` is an ordinary dynamic value and the spine is walked at run
// time.  Here the alternatives are built under `@special`, so each of them
// stays a known shape across the join; `@specialize` on the pattern parameters
// then gives `spmv` one fully unrolled body per alternative, reached through a
// single dispatch on which stencil was picked.
//
// This is the realistic case: a solver has a handful of stencils compiled in
// and chooses one per problem, not per multiply.

// `Sx` is not staged, so calls to it whose arguments are all statically known
// are evaluated during specialization.  It also gives us the array allocation
// and mutation that the staged IR itself does not provide.
module Sx with
  fun init(len, dft) = globalThis.Array(len).fill(dft)
  fun setAt(a, i, v) =
    set a.(i) = v
    a
  fun len(a) = a.length

staged module SpecialSparseTensor with

  // ---------------------------------------------------------------------------
  // The static spine: lists of column indices and of rows.
  // ---------------------------------------------------------------------------

  object Nil
  class Cons(val head, val tail)

  class Row(val start, val cols)

  @specialize
  fun rowLen(cols) =
    if cols is
      Cons(_, rest) then 1 + rowLen(rest)
      else 0

  @specialize
  fun numRows(pat) =
    if pat is
      Cons(_, rest) then 1 + numRows(rest)
      else 0

  @specialize
  fun nnz(pat) =
    if pat is
      Cons(r, rest) then rowLen(r.cols) + nnz(rest)
      else 0

  // Turns a list of column lists into a list of rows, assigning each row the
  // offset at which its nonzeros start in the flat value array.  The spine is
  // built `@special` so that a pattern chosen at run time is still a known
  // shape in each branch of that choice.
  @specialize
  fun withStarts(rows, k) =
    if rows is
      Cons(cols, rest) then
        (@special new Cons((@special new Row(k, cols)), withStarts(rest, k + rowLen(cols))))
      else Nil

  // ---------------------------------------------------------------------------
  // Building patterns out of plain arrays of column indices.
  // ---------------------------------------------------------------------------

  fun rowOf(t, i) =
    if i == Sx.len(t) then Nil
    else (@special new Cons(t.(i), rowOf(t, i + 1)))

  fun patOf(t, i) =
    if i == Sx.len(t) then Nil
    else (@special new Cons(rowOf(t.(i), 0), patOf(t, i + 1)))

  // The tridiagonal stencil on n points: row i touches i-1, i and i+1, with
  // the first and last rows clipped to the two neighbours they have.
  fun triRow(i, n) =
    if
      i == 0 then (@special new Cons(0, (@special new Cons(1, Nil))))
      i == n - 1 then (@special new Cons(n - 2, (@special new Cons(n - 1, Nil))))
      else (@special new Cons(i - 1, (@special new Cons(i, (@special new Cons(i + 1, Nil))))))

  fun triPat(i, n) =
    if i == n then Nil
    else (@special new Cons(triRow(i, n), triPat(i + 1, n)))

  // ---------------------------------------------------------------------------
  // Sparse matrix-vector product.
  //
  //   y[i] = sum over the nonzeros (i, j) of  vals[k] * x[j]
  //
  // where k runs over `start .. start + rowLen - 1` for row i.  The first
  // nonzero of a row is peeled off so that the accumulator starts from a
  // product rather than from a zero that would have to be added.
  // ---------------------------------------------------------------------------

  fun rowDot(@specialize cols, acc, vals, x, k) =
    if cols is
      Cons(j, rest) then rowDot(rest, acc + vals.(k) * x.(j), vals, x, k + 1)
      else acc

  fun goRows(@specialize pat, vals, x, y, i) =
    if pat is
      Cons(r, rest) then
        if r.cols is
          Cons(j, rest') then
            goRows(rest, vals, x,
              Sx.setAt(y, i, rowDot(rest', vals.(r.start) * x.(j), vals, x, r.start + 1)), i + 1)
          else goRows(rest, vals, x, Sx.setAt(y, i, 0.0), i + 1)
      else y

  fun spmv(@specialize pat, vals, x) =
    goRows(pat, vals, x, Sx.init(numRows(pat), 0.0), 0)

  // ---------------------------------------------------------------------------
  // Reference implementation: scatter the nonzeros into a dense row-major
  // matrix and multiply densely.  Used by the tests to check `spmv`, and by
  // the benchmark as the "do not exploit the sparsity at all" baseline.
  // ---------------------------------------------------------------------------

  fun denseRow(@specialize cols, vals, a, i, c, k) =
    if cols is
      Cons(j, rest) then
        denseRow(rest, vals, Sx.setAt(a, i * c + j, vals.(k)), i, c, k + 1)
      else a

  fun denseRows(@specialize pat, vals, a, i, c) =
    if pat is
      Cons(r, rest) then
        denseRows(rest, vals, denseRow(r.cols, vals, a, i, c, r.start), i + 1, c)
      else a

  fun toDense(@specialize pat, vals, c) =
    denseRows(pat, vals, Sx.init(numRows(pat) * c, 0.0), 0, c)

  fun denseDot(a, x, i, c, j, acc) =
    if j == c then acc
    else denseDot(a, x, i, c, j + 1, acc + a.(i * c + j) * x.(j))

  fun denseMulRows(a, x, y, i, r, c) =
    if i == r then y
    else denseMulRows(a, x, Sx.setAt(y, i, denseDot(a, x, i, c, 0, 0.0)), i + 1, r, c)

  fun denseMul(a, x, r, c) =
    denseMulRows(a, x, Sx.init(r, 0.0), 0, r, c)

  // ---------------------------------------------------------------------------
  // Entry points, matching `NaiveSparseTensor` one for one.
  // ---------------------------------------------------------------------------

  // A hand-written 4x5 pattern whose rows hold 2, 1, 3 and 1 nonzeros, to
  // exercise rows of differing length.
  fun pat45() = withStarts(patOf([[0, 2], [1], [0, 3, 4], [4]], 0), 0)

  fun patTri8() = withStarts(triPat(0, 8), 0)

  // 2 + 62*3 + 2 = 190 and 2 + 126*3 + 2 = 382 nonzeros.
  fun patTri64() = withStarts(triPat(0, 64), 0)

  fun patTri128() = withStarts(triPat(0, 128), 0)

  fun spmv45(vals, x) = spmv(pat45(), vals, x)

  fun spmvTri8(vals, x) = spmv(patTri8(), vals, x)

  fun spmvTri64(vals, x) = spmv(patTri64(), vals, x)

  fun spmvTri128(vals, x) = spmv(patTri128(), vals, x)

  // A stencil is a pattern wrapped in a class, so that picking one at run time
  // is a choice between instances rather than between bare cons spines.
  staged class Stencil(val pat) with
    fun mul(vals, x) = spmv(pat, vals, x)

  // The stencil is picked at run time out of a fixed menu.
  // Each alternative is `@special`, so `mul` is specialized once per stencil
  // and the only thing left at run time is the choice itself.
  fun stencil(k) =
    if k is
      0 then (@special new Stencil(pat45()))
      1 then (@special new Stencil(patTri64()))
      else (@special new Stencil(patTri128()))

  fun spmvStencil(k, vals, x) = stencil(k).mul(vals, x)
