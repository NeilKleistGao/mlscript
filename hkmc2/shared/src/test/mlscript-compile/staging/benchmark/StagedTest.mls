import "./../out/StagedRegExp.mls"

let text = fs.readFileSync("./input-text.txt", "utf8")

let begin1 = globalThis.process.hrtime()
StagedRegExp.matchAllEmail(text)
let diff1 = globalThis.process.hrtime(begin1)
let diffTime1 = diff1.0 * 1000000000 + diff1.1
console.log("time: " + diffTime1)

let begin2 = globalThis.process.hrtime()
StagedRegExp.matchAllURI(text)
let diff2 = globalThis.process.hrtime(begin2)
let diffTime2 = diff2.0 * 1000000000 + diff2.1
console.log("time: " + diffTime2)

let begin3 = globalThis.process.hrtime()
StagedRegExp.matchAllIPv4(text)
let diff3 = globalThis.process.hrtime(begin3)
let diffTime3 = diff3.0 * 1000000000 + diff3.1
console.log("time: " + diffTime3)
