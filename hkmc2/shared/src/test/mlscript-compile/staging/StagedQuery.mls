#config(noFreeze: true)

module SeqHelper with
  fun pushDyn(arr, ele) =
    arr.push(ele)
    arr
  fun tail(arr) = arr.slice(1)

staged module StagedQuery with
  class Student(val name, val mathGrade, val physGrade, val chemGrade, val engGrade)

  staged class Pred with
    fun test(obj)

  staged class GreaterThan(val v, val field) extends Pred with
    fun test(obj) = obj.(field) > v
  staged class GreaterEqThan(val v, val field) extends Pred with
    fun test(obj) = obj.(field) >= v
  staged class LessThan(val v, val field) extends Pred with
    fun test(obj) = obj.(field) < v
  staged class LessEqThan(val v, val field) extends Pred with
    fun test(obj) = obj.(field) <= v
  staged class Eq(val v, val field) extends Pred with
    fun test(obj) = obj.(field) == v
  staged class NotEq(val v, val field) extends Pred with
    fun test(obj) = not obj.(field) == v
  staged class And(val lhs, val rhs) extends Pred with
    fun test(obj) = lhs.test(obj) and rhs.test(obj)
  staged class Or(val lhs, val rhs) extends Pred with
    fun test(obj) = lhs.test(obj) || rhs.test(obj)
  staged class Not(val e) extends Pred with
    fun test(obj) = not e.test(obj)

  fun filterImpl(arr, pred, res) =
    if arr is
      [] then res
      else filterImpl(SeqHelper.tail(arr), pred, if pred.test(arr.0) then SeqHelper.pushDyn(res, arr.0) else res)
  fun filter(arr, pred) = filterImpl(arr, pred, [])

  fun filterGoodStudents(students, spec) =
    let pred =
      if spec then new And(new And(new GreaterEqThan(80, "mathGrade"), new GreaterEqThan(80, "engGrade")), new And(new GreaterThan(95, "physGrade"), new GreaterThan(95, "chemGrade")))
      else new And(new And(new GreaterEqThan(90, "mathGrade"), new GreaterEqThan(90, "engGrade")), new And(new GreaterEqThan(90, "physGrade"), new GreaterEqThan(90, "chemGrade")))
    filter(students, pred)
