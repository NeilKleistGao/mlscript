#config(noFreeze: true)

open annotations { special, specialize }

staged module SpecialRegExpIPv4Ls with
  class Some(val x)
  object None

  class Cons(val x, val xs)
  object Nil

  fun len(s) = s.length

  fun digit() = new Cons("0", new Cons("1", new Cons("2", new Cons("3", new Cons("4", new Cons("5", new Cons("6", new Cons("7", new Cons("8", new Cons("9", Nil))))))))))

  fun has(ls, e) =
    if ls is
      Cons(x, xs) then x == e || has(xs, e)
      else false

  fun charListEq(xs, ys) =
    if xs is
      Nil then ys is Nil
      Cons(x, xs') then
        if ys is
          Cons(y, ys') then x == y and charListEq(xs', ys')
          else false
      else false

  fun push(ls, e) =
    if ls is
      Cons(x, xs) then new Cons(x, push(xs, e))
      else new Cons(e, Nil)

  @specialize
  fun pushUnique(ls, e) =
    if ls is
      Cons(x, xs) then
        if x.eq(e) then ls
        else (@special new Cons(x, pushUnique(xs, e)))
      else (@special new Cons(e, Nil))

  fun concatUnique(xs, ys) =
    if ys is
      Cons(y, ys') then concatUnique(pushUnique(xs, y), ys')
      else xs

  @specialize
  fun lsEq(xs, ys) =
    if xs is
      Nil then ys is Nil
      Cons(x, xs') then
        if ys is
          Cons(y, ys') then x.eq(y) and lsEq(xs', ys')
          else false
      else false

  staged class RegExp() with
    fun derive(c)
    fun canBeEmpty()
    fun normalize()
    fun eq(other)
    fun startsWith(c)
    fun flat()

  staged object Nothing extends RegExp() with
    fun derive(c) = this
    fun canBeEmpty() = false
    fun normalize() = this
    fun eq(other) = other is Nothing
    fun startsWith(c) = false
    fun flat() = Nil

  staged object Empty extends RegExp() with
    fun derive(c) = Nothing
    fun canBeEmpty() = true
    fun normalize() = this
    fun eq(other) = other is Empty
    fun startsWith(c) = false
    fun flat() = (@special new Cons(this, Nil))

  staged class Exact(val ch) extends RegExp() with
    fun derive(c) =
      if startsWith(c) then Empty
      else Nothing
    fun canBeEmpty() = false
    fun normalize() = this
    fun eq(other) =
      if other is Exact(ch') then ch == ch' else false
    fun startsWith(c) = ch == c
    fun flat() = (@special new Cons(this, Nil))

  staged class Any() extends RegExp() with
    fun derive(c) = Empty
    fun canBeEmpty() = false
    fun normalize() = this
    fun eq(other) = other is Any
    fun startsWith(c) = true
    fun flat() = (@special new Cons(this, Nil))

  staged class Not(val chars) extends RegExp() with
    fun derive(c) =
      if startsWith(c) then Empty else Nothing
    fun canBeEmpty() = false
    fun normalize() = this
    fun eq(other) =
      if other is Not(chars') then charListEq(chars, chars') else false
    fun startsWith(c) = not has(chars, c)
    fun flat() = (@special new Cons(this, Nil))

  fun notWord() = new Not(words().chars)
  fun notSpace() = new Not(spaces().chars)
  fun notDigit() = new Not(digits().chars)

  @specialize
  fun mkUnion(ls) =
    if ls is
      Cons(x, Nil) then x
      Cons(x, xs) then (@special new Altern(x, mkUnion(xs)))
      else Nothing

  staged class Altern(val p1, val p2) extends RegExp() with
    fun derive(c) = (@special new Altern(p1.derive(c), p2.derive(c))).normalize()
    fun canBeEmpty() = p1.canBeEmpty() || p2.canBeEmpty()
    fun normalize() =
      mkUnion(flat())
    fun eq(other) =
      if other is
        Altern then lsEq(flat(), other.flat())
        else false
    fun startsWith(c) = p1.startsWith(c) || p2.startsWith(c)
    fun flat() =
      let p1' = p1.flat()
      let p2' = p2.flat()
      concatUnique(concatUnique(Nil, p1'), p2')

  fun question(r) = (@special new Altern(r, Empty))

  staged class In(val chars) extends RegExp() with
    fun derive(c) =
      if startsWith(c) then Empty else Nothing
    fun canBeEmpty() = false
    fun normalize() = this
    fun eq(other) =
      if other is In(chars') then charListEq(chars, chars') else false
    fun startsWith(c) = has(chars, c)
    fun flat() = (@special new Cons(this, Nil))

  fun words() = new In(new Cons("a", new Cons("b", new Cons("c", new Cons("d", new Cons("e", new Cons("f", new Cons("g", new Cons("h", new Cons("i", new Cons("j", new Cons("k", new Cons("l", new Cons("m", new Cons("n", new Cons("o", new Cons("p", new Cons("q", new Cons("r", new Cons("s", new Cons("t", new Cons("u", new Cons("v", new Cons("w", new Cons("x", new Cons("y", new Cons("z", new Cons("A", new Cons("B", new Cons("C", new Cons("D", new Cons("E", new Cons("F", new Cons("G", new Cons("H", new Cons("I", new Cons("J", new Cons("K", new Cons("L", new Cons("M", new Cons("N", new Cons("O", new Cons("P", new Cons("Q", new Cons("R", new Cons("S", new Cons("T", new Cons("U", new Cons("V", new Cons("W", new Cons("X", new Cons("Y", new Cons("Z", Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))
  fun spaces() = new In(new Cons(" ", new Cons("\n", new Cons("\t", new Cons("\r", Nil)))))
  fun digits() = new In(digit())

  staged class Concat(val p1, val p2) extends RegExp() with
    fun derive(c) =
      let p1' = p1.derive(c)
      if p1.canBeEmpty() then
        (@special new Altern((@special new Concat(p1', p2)), p2.derive(c))).normalize()
      else (@special new Concat(p1', p2)).normalize()
    fun canBeEmpty() = p1.canBeEmpty() and p2.canBeEmpty()
    fun normalize() =
      let p1' = p1.normalize()
      if p1' is
        Empty then p2.normalize()
        Nothing then p1'
        else (@special new Concat(p1', p2.normalize()))
    fun eq(other) =
      if other is Concat(p1', p2') then p1.eq(p1') and p2.eq(p2') else false
    fun startsWith(c) = p1.startsWith(c) || (p1.canBeEmpty() and p2.startsWith(c))
    fun flat() = (@special new Cons(this, Nil))

  fun nTimes(r, i) =
    if i == 1 then r
    else (@special new Concat(r, nTimes(r, i - 1)))

  staged class Star(val p) extends RegExp() with
    fun derive(c) = (@special new Concat(p.derive(c), (@special new Star(p)))).normalize()
    fun canBeEmpty() = true
    fun normalize() = (@special new Star(p.normalize()))
    fun eq(other) =
      if other is Star(p') then p.eq(p') else false
    fun startsWith(c) = p.startsWith(c)
    fun flat() = (@special new Cons(this, Nil))

  fun plus(r) = (@special new Concat(r, (@special new Star(r))))

  fun matchImpl(@specialize p, s, i, j) = if
    len(s) == j and
      p.canBeEmpty() then new Some(s.substring(i, j))
      else None
    p is Nothing then None
    let c = s.(j)
    p.startsWith(c) then matchImpl(p.derive(c), s, i, j + 1)
    p.canBeEmpty() then new Some(s.substring(i, j))
    else None
  fun match(p, s) =
    matchImpl(p, s, 0, 0)

  fun matchAllImpl(@specialize p, s, i, res) =
    if len(s) == i then res
    else
      if matchImpl(p, s, i, i) is
        Some(ss) then
          if len(ss) > 0 then matchAllImpl(p, s, i + len(ss), push(res, ss))
          else matchAllImpl(p, s, i + 1, res)
        else matchAllImpl(p, s, i + 1, res)
  fun matchAll(p, s) =
    matchAllImpl(p, s, 0, Nil)

  // ((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])
  fun matchAllIPv4(s) =
    let fo = new In(new Cons("0", new Cons("1", new Cons("2", new Cons("3", new Cons("4", Nil))))))
    let fi = new In(new Cons("0", new Cons("1", new Cons("2", new Cons("3", new Cons("4", new Cons("5", Nil)))))))
    let segment = new Altern(new Concat(new Exact("2"), new Concat(new Exact("5"), fi)), new Altern(
      new Concat(new Exact("2"), new Concat(fo, digits())),
      new Concat(question(new Exact("1")), new Concat(question(digits()), digits()))
    ))
    let ipv4 = new Concat(nTimes(new Concat(segment, new Exact(".")), 3), segment)
    matchAll(ipv4, s)
