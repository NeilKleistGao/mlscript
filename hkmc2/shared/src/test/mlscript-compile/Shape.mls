#config(liftDefns: None)

import "./Block.mls"
import "./Option.mls"
import "./CachedHash.mls"
import "./Predef.mls"
import "./ShapeSet.mjs"

open Block { Literal, ConcreteClassSymbol, Param, isPrimitiveType, isPrimitiveTypeOf }
open Option
open Predef { Symbols }

type Shape = Shape.Shape
type ShSet = ShapeSet.ShapeSet

module Shape with...

val printer = Block.Printer(None)

class Shape extends CachedHash with
  constructor
    Dyn()
    Lit(val l: Literal)
    Arr(val shapes: Array[ShSet])
    // superShape is the direct superclass instance shape, or bot when the class has no superclass.
    Class(val sym: ConcreteClassSymbol, val fields: Array[ShSet], val superShape: ShSet, val isSpecial: Bool) // TODO: track the auxParams as well
  // Only meaningful on a pattern shape (see `ucsPatternShape`), which is what a `UCS` arm carries.
  fun toPattern(printer) = showPattern(this, printer)

fun show(s: Shape) =
  if s is
    Dyn then "D"
    Lit(lit) then "L(" + printer.showLiteral(lit) + ")"
    Arr(shapes) then "A(" + shapes.map(_.toString()).join(", ") + ")"
    Class(sym, fields, superShape, isSpecial) then
      "C(" + printer.showSymbol(sym) + ", {" + [...fields.entries()].map(e => e.1.toString()).join(", ") + "}" +
        ", " + superShape.toString() +
        (if isSpecial then ", true)" else ")")

// `@matchShapes` requires every constructor field to be spelled out, so unknown
// fields become explicit wildcards instead of being elided as in a UCS pattern.
fun classArity(sym: ConcreteClassSymbol) =
  if sym.paramsOpt is Some(ps) then ps.length else 0

fun showPatternSet(s: ShSet, printer) =
  if s.values() is [shape] then showPattern(shape, printer) else "_"

fun showPatternFields(fields: Array[ShSet], arity: Int, printer) =
  Array(arity).fill(0).map((_, i, _) =>
    if i < fields.length then showPatternSet(fields.(i), printer)
    else "_"
  ).join(", ")

fun showPattern(s: Shape, printer) =
  if s is
    Dyn then "_"
    Lit(lit) then printer.showLiteral(lit)
    Arr(shapes) then "[" + shapes.map(showPatternSet(_, printer)).join(", ") + "]"
    Class(sym, fields, _, isSpecial) then
      let cls = printer.showSymbol(sym)
      let arity = classArity(sym)
      if arity is 0 then cls
      // a non-special shape carries no reliable field information
      else cls + "(" + showPatternFields(if isSpecial then fields else [], arity, printer) + ")"

// This mask only coarsens emitted UCS patterns; see `ucsPatternShape`.
fun sharedPatternFields(s: Shape, branchShapes: Array[Shape]) =
  if s is
    Class(sym1, fields, _, _) then
      let sameClassShapes = branchShapes.filter(s' =>
        if s' is Class(sym2, _, _, _) then
          getActualClass(sym1.value) == getActualClass(sym2.value)
        else false
      )
      if sameClassShapes.length < 2 then Array(fields.length).fill(false)
      else fields.map((field, i, _) =>
        sameClassShapes.every(other =>
          if other is Class(_, otherFields, _, _) then
            i < otherFields.length and field.hash() == otherFields.(i).hash()
          else false
        )
      )

// A *pattern shape* is a shape read as a `@matchShapes` pattern: `Dyn` is the wildcard
// `_`, and every other shape matches exactly the values `showPattern` says it does. It is
// what the specializer refines branch shapes with, so the printed pattern and the shapes
// the branch is specialized at cannot disagree: `showPattern(patternShape(s))` prints
// exactly what `showPattern(s)` prints, and `refine(s, patternShape(s))` is `[s]`.

fun patternSetShape(ss: ShSet) =
  if ss.values() is [shape] then ShapeSet.lift(patternShape(shape)) else ShapeSet.mkDyn()

// mask marks the field positions that become wildcards regardless of the shape we know
// for them.
fun patternFieldShapes(fields: Array[ShSet], arity: Int, mask: Array[Bool]) =
  Array(arity).fill(0).map((_, i, _) =>
    if i < mask.length and mask.(i) then ShapeSet.mkDyn()
    else if i < fields.length then patternSetShape(fields.(i))
    else ShapeSet.mkDyn()
  )

fun patternShape(s: Shape): Shape =
  if s is
    Dyn then s
    Lit then s
    Arr(shapes) then Arr(shapes.map(patternSetShape))
    Class(sym, fields, _, isSpecial) then
      let arity = classArity(sym)
      Class(sym, patternFieldShapes(if isSpecial then fields else [], arity, []), ShapeSet.mkDyn(), isSpecial)

// The pattern a `shape.match` branch is emitted with. Fields that all the same-class
// branches share are printed as wildcards, which makes this pattern coarser than the
// shapes it was printed from: a value of another branch's shape may well match it. The
// branch must therefore be specialized at the scrutinee *refined by this pattern* (see
// `refine`), not at the shapes it was printed from.
fun ucsPatternShape(s: Shape, branchShapes: Array[Shape]) =
  if s is
    Class(sym, fields, _, true) and classArity(sym) > 0 then
      Class(sym, patternFieldShapes(fields, classArity(sym), sharedPatternFields(s, branchShapes)), ShapeSet.mkDyn(), true)
    else patternShape(s)

// `refine(s, q)` is the part of `s` whose values the pattern shape `q` accepts: each field
// is narrowed by the pattern's field, a `Dyn` becomes the pattern itself, and what the
// pattern rules out disappears. A shape the pattern does not narrow is returned as the very
// same object, which is what `covers` relies on: comparing rebuilt shapes by `hash()` means
// rendering them, and these shapes can be large. Unlike `filter` against a `Case`, this
// keeps whatever `s` knows beyond the pattern. Deep patterns accept the exact class only, as the class-tags
// pass checks them (`Shape.<=` in `ClassTagsTransformer.scala`), so a subclass is ruled out.
//
// History: a branch used to be specialized at the union of the shapes that printed its
// pattern. That is unsound once a pattern is coarser than its shapes (masked fields and
// non-special nested classes make it so) and patterns overlap: with `@special` `C` and
// plain `D`, the members `C(D(1), _)` and `C(D(2), 5)` print `C(D(_), _)` and
// `C(D(_), 5)`, and a `C(D(2), 5)` takes the first branch, which assumed `D(1)`. The
// formal development (`refine` in the Lean proof's `Shapes.lean`) found the same gap.
fun refine(s: Shape, q: Shape): Array[Shape] =
  if [s, q] is
    [_, Dyn] then [s]
    [Dyn, _] then [q]
    [Lit(l1), Lit(l2)] and l1 == l2 then [s]
    [Arr(fields), Arr(patternFields)] and fields.length == patternFields.length and refineFields(fields, patternFields) is Some(refined) then
      [if sameElements(refined, fields) then s else Arr(refined)]
    [Class(sym, fields, superShape, isSpecial), Class(patternSym, patternFields, _, _)] and sameClass(sym, patternSym) and refineFields(fields, patternFields) is Some(refined) then
      [if sameElements(refined, fields) then s else Class(sym, refined, superShape, isSpecial)]
    else []

fun sameElements(xs, ys) =
  xs.length == ys.length and xs.every((x, i, _) => x === ys.(i))

fun sameClass(sym1, sym2) = ShapeSet.classGroupKey(sym1) == ShapeSet.classGroupKey(sym2)

// A pattern field is always a single shape (see `patternSetShape`).
fun refineSet(ss: ShSet, q: ShSet) =
  if q.values() is
    [Dyn] then ss
    [qShape] and
      let members = ss.values()
      let refined = members.flatMap(refine(_, qShape))
      sameElements(refined, members) then ss
      else ShapeSet.liftMany(refined)

// None when some field rules the whole shape out. A field past the pattern's arity is
// left alone, as `showPatternFields` prints it as a wildcard.
fun refineFields(fields: Array[ShSet], patternFields: Array[ShSet]) =
  let refined = fields.map((field, i, _) =>
    if i < patternFields.length then refineSet(field, patternFields.(i)) else field
  )
  if refined.some((field, i, _) => field.isEmpty() and not fields.(i).isEmpty()) then None
  else Some(refined)

// Every value of `s` matches the pattern shape `q`.
fun covers(q: Shape, s: Shape) =
  refine(s, q) is [r] and r === s

fun sel(s1: Shape, s2: Shape): Array[Shape] =
  if [s1, s2] is
    [Class(ConcreteClassSymbol(_, _, paramsOpt, auxParams, _), params, superShape, _), Lit(n)] and n is Str and
      let fieldIndex = if paramsOpt is Some(paramsSymb) then paramsSymb.map(_.sym.name).indexOf(n) else -1
      fieldIndex is
        -1 then superShape.values().flatMap(sel(_, s2))
        n then params.(n).values()
    [Class(ConcreteClassSymbol, p, _, _), Dyn] then [Dyn()]
    [Dyn, Lit(n)] and 
      n is Str then [Dyn()]
      n is Int then [Dyn()]
      else throw Error("Unknown selection")
    [Arr(shapes), Lit(n)] and // n can be both string or integer
      n < shapes.length then shapes.(n).values() // This utilizes the string and number conversion in JS lol
      else throw Error("Array out of bound")
    [Arr(shapes), Dyn] then
      shapes.flatMap(_.values())
    [Dyn, Dyn] then [Dyn()]
    else []

fun static(s: Shape) = 
  if s is
    Dyn then false
    Lit(l) then not (l is Str and isPrimitiveType(l)) // redundant bracket?
    Class(_, params, superShape, _) then
      params.every(_.values() is [v] and static(v)) and
        superShape.values().every(static)
    Arr(shapes) then shapes.every(_.values() is [v] and static(v))    

open Block { Case }

fun silh(p: Case): Shape = if p is
  Block.Lit(l) then Lit(l)
  Block.Cls(clsSymb, path) then
    let paramsSize = if clsSymb.paramsOpt is Some(params) then params.length else 0
    Class(clsSymb, Array(paramsSize).fill(ShapeSet.mkDyn()), ShapeSet.mkDyn(), false)
  Block.Tup(n) then Arr(Array(n).fill(ShapeSet.mkDyn()))

fun getActualClass(c) = if not (c."class" is undefined) then c.class else c
fun isSubClassOf(d, b) =
  let dClass = getActualClass(d)
  let bClass = getActualClass(b)
  dClass == bClass || bClass.isPrototypeOf(dClass)

fun filter(s: Shape, p: Case): Array[Shape] =
  if [s, p] is
    [Lit(l1), Block.Lit(l2)] and l1 == l2 then [s]
    [Lit(l), Block.Cls(c, _)] and isPrimitiveTypeOf(c, l) then [s] 
    [Arr(ls), Block.Tup(n)] and ls.length == n then [s]
    [Class(c1, _, _, _), Block.Cls(c2, _)] and c1 is ConcreteClassSymbol and c2 is ConcreteClassSymbol and
      c1 == c2 then [s] // TODO: is === possible?
    [Class(c1, _, _, _), Block.Cls(c2, _)] and c1 is ConcreteClassSymbol and c2 is ConcreteClassSymbol and
      isSubClassOf(c1.value, c2.value) then [s]
    [Dyn, _] then [silh(p)]
    else []

fun rest(s: Shape, p: Case): Array[Shape] =
  if [s, p] is
    [Lit(l1), Block.Lit(l2)] and l1 == l2 then []
    [Lit(l), Block.Cls(c, _)] and isPrimitiveTypeOf(c, l) then []
    [Arr(ls), Block.Tup(n)] and ls.length == n then []
    [Class(c1, _, _, _), Block.Cls(c2, _)] and c1 is ConcreteClassSymbol and c2 is ConcreteClassSymbol and
      c1 == c2 then [] // TODO: is === possible?
    [Class(c1, _, _, _), Block.Cls(c2, _)] and c1 is ConcreteClassSymbol and c2 is ConcreteClassSymbol and
      isSubClassOf(c1.value, c2.value) then []
    [Class(c1, _, _, _), Block.Cls(c2, _)] and c1.name == c2.name then [s]
    [Dyn, _] then [s]
    else [s]
