  fun matchSeg(s, d) =
    let fo = new In(["0", "1", "2", "3", "4"])
    let fi = new In(["0", "1", "2", "3", "4", "5"])
    let segment = new Union(new Concat(new Exact("2"), new Concat(new Exact("5"), fi)), new Union(
      new Concat(new Exact("2"), new Concat(fo, digits())),
      new Concat(question(new Exact("1")), new Concat(question(digits()), digits()))
    ))
    match(if d then new Concat(segment, new Exact(".")) else segment, s)

  fun matchIPv4(s, res) =
    if len(s) === 0 then res
    else
      if matchSeg(s, true) is
        Some(s1) then
          let r1 = s.slice(len(s1))
          if matchSeg(r1, true) is
            Some(s2) then
              let r2 = r1.slice(len(s2))
              if matchSeg(r2, true) is
                Some(s3) then
                  let r3 = r2.slice(len(s3))
                  if matchSeg(r3, false) is
                    Some(s4) then matchIPv4(r3.slice(len(s4)), SeqHelper.push(res, s1 + s2 + s3 + s4))
                    else matchIPv4(s.slice(1), res)
                else matchIPv4(s.slice(1), res)
            else matchIPv4(s.slice(1), res)
        else matchIPv4(s.slice(1), res)

  // ((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])
  fun matchAllIPv4(s) = matchIPv4(s, [])
