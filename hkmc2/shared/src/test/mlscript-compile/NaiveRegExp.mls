import "./Predef.mls"
import "./Option.mls"
open Predef
open Option

module NaiveRegExp with
  class RegExp() with
    fun match(s) = ???
    fun canBeEmpty() = ???

  class Exact(val p) extends RegExp with // single character
    fun match(s) = if s.length > 0 and s.0 === p then Some(p) else None
    fun canBeEmpty() = false

  class Any() extends RegExp with // pattern `.`
    fun match(s) = if s.length > 0 then Some(s.0) else None
    fun canBeEmpty() = false

  class Not(val chars) extends RegExp with // pattern `[^...]`
    fun check(c, i) =
      if i === chars.length then true
      else if chars.(i) === c then false
      else check(c, i + 1)
    fun match(s) = if s.length > 0 and check(s.0, 0) then Some(s.0) else None
    fun canBeEmpty() = false

  val notWord = Not(["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"])

  class Star(val r) extends RegExp with // pattern (...)*
    fun match(s) =
      if r.match(s) is
        Some(ss) and ss.length > 0 then
          let rst = s.slice(ss.length)
          if match(rst) is
            Some(ss2) then Some(ss + ss2)
            else Some(ss)
        else Some("")
    fun canBeEmpty() = true

  class Question(val r) extends RegExp with // pattern (...)?
    fun match(s) =
      if r.match(s) is
        Some(ss) then Some(ss)
        None then Some("")
    fun canBeEmpty() = true

  class Union(val r1, val r2) extends RegExp with // pattern (r1 | r2)
    fun match(s) =
      if r1.match(s) is
        Some(ss) then Some(ss)
        else r2.match(s)
    fun canBeEmpty() = r1.canBeEmpty() || r2.canBeEmpty()

  fun setOf(arr) =
    fun impl(res, arr) =
      if arr is
        [] then res
        else impl(Union(Exact(arr.0), res), arr.slice(1))
    if arr.length >= 1 then
      impl(Exact(arr.0), arr.slice(1))
    else ??? // fail

  val words = setOf(["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"])

  // FIXME
  class Concat(val r1, val r2) extends RegExp with // pattern r1 r2
    fun match(s) =
      if r1.match(s) is
        Some(ss1) then
          let rst = s.slice(ss1.length)
          if r2.match(rst) is
            Some(ss2) then Some(ss1 + ss2)
            else None
        else None
    fun canBeEmpty() = r1.canBeEmpty() && r2.canBeEmpty()

  fun plus(r) = Concat(r, Star(r)) // pattern (...)+ 
  fun nTimes(r, i) =
    if i === 1 then r
    else Concat(r, nTimes(r, i - 1))

  fun matchAll(p, s) =
    fun impl(s, res) = 
      if s === "" then res
      else
        if p.match(s) is
          Some(ss) then
            let sc = if ss.length === 0 then 1 else ss.length
            let rst = s.slice(sc)
            impl(rst, res.concat(ss))
          else
            let rst = s.slice(1) // TODO: improve?
            impl(rst, res)
    impl(s, [])
