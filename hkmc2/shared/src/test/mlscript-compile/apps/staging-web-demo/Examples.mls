import "../../MutMap.mls"
import "../../Predef.mls"

open Predef
module Examples with...

val examples = MutMap.empty

examples |> MutMap.insert of
  "Power.mls"
  name: "Power"
  source: """staged module Math with
  fun pow(x, n) =
    if n is
      1 then x
      else x * pow(x, n - 1)
  fun square(x) = pow(x, 2)
  fun cube(x) = pow(x, 3)
"""
