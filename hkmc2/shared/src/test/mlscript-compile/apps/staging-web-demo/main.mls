import "../../StrOps.mls"
import "../../Iter.mls"
import "../../XML.mls"
import "../../Option.mls"
import "../../Runtime.mls"
import "../../Predef.mls"
import "../../MutMap.mls"
import "../../Block.mls"
import "../../CachedHash.mls"
import "../../Shape.mls"
import "../../ShapeSet.mls"
import "../../SpecializeHelpers.mls"
import "./Examples.mls"
import "../../../../../../js/target/scala-3.7.4/hkmc2-opt/MLscript.mjs"


open XML { elem }
open Predef
open Option { Some, None }
open Examples

module Main with ...

let query = document.querySelector.bind(document)
let editor = query("#source-editor")
let selector = query("#demo-select")
let parseButton = query("#compile-button")
let runButton = query("#run-button")
let statusPanel = query("#compile-status")
let outputPanel = query("#specialized-code")
let runnerEditor = query("#runner-editor")
let runnerOutput = query("#runner-output")
let runStatus = query("#run-status")
let topLevelModulePattern = new RegExp("""^\s*(?:staged\s+)?module\s+([A-Za-z_][A-Za-z0-9_]*)\s+with\b""", "m")
// TODO: do not skip staged 

let specializedCode = ""

examples Iter.each of case [key, example] then
  let option = document.createElement of "option"
  set option.value = key
  set option.textContent = example.name
  selector.appendChild of option
  // Load the first example.
  if editor.value is "" do
    set editor.value = example.source

// Make pressing <kbd>Tab</kbd> add two spaces at the caret's position.
editor.addEventListener of "keydown", event =>
  if event.key is "Tab" do
    // Prevent the default tab behavior (focusing the next element).
    event.preventDefault()
    let start = editor.selectionStart
    let end = editor.selectionEnd
    set editor.value = editor.value.substring(0, start) + "  " + editor.value.substring(end)
    set editor.selectionEnd = start + 2
    set editor.selectionStart = editor.selectionEnd

selector.addEventListener of "change", event =>
  if examples |> MutMap.get(selector.value) is
    Some(example) do set editor.value = example.source
    None do throw new Error of "Example \"" + selector.value + "\" not found"

fun formatError(error) =
  error.name + ": " + error.message +
  if error.stack is Str then "\n" + error.stack else ""

fun topLevelModuleName(source) =
  let matched = topLevelModulePattern.exec(source)
  if matched is null then None else Some(matched.[1])

fun currentTopLevelModuleName() =
  topLevelModuleName(editor.value)

parseButton.addEventListener of "click", event =>
  set outputPanel.textContent = "Compiling..."
  Runtime.try_catch of
    () =>
      let moduleName =
        if currentTopLevelModuleName() is
          Some(name) then name
          None then
            set statusPanel.textContent = "No staged module found."
            ""
      let res = MLscript.compile of
        traces:
          codegen: false
        editor.value + "\n" + moduleName + ".show()"
      let sections = mut []
      let generatedVars = res.codegen.vars.trim()
      let generatedCode = res.codegen.code.trim()
      let compiledCode =
        if generatedVars != "" && generatedCode != "" then generatedVars + "\n\n" + generatedCode
        else generatedVars + generatedCode
      let hasGeneratedCode = compiledCode != ""
      if hasGeneratedCode do
        console.log(generatedVars + generatedCode)
        let res = globalThis.eval(generatedVars + generatedCode)
        set specializedCode = res
        sections.push(res)
      if res.codegen.diagnostics.length > 0 do
        sections.push of "Diagnostics:\n" + res.codegen.diagnostics.join("\n")
      set outputPanel.textContent =
        if sections.length > 0 then sections.join("\n\n")
        else "No specialized code was generated."
      set statusPanel.textContent =
        if res.codegen.diagnostics.length > 0 then
          "Compilation completed with code generation diagnostics."
        else if hasGeneratedCode then
          "Compilation succeeded. Specialized code is shown below."
        else
          "Compilation completed. No specialized code was generated."
      
    error =>
      set specializedCode = ""
      set statusPanel.textContent = "Compilation failed. See the error output below."
      set outputPanel.textContent = formatError(error)

runButton.addEventListener of "click", event =>
  set runStatus.textContent = "Running the combined code..."
  set runnerOutput.textContent = "Running..."
  Runtime.try_catch of
    () =>
      if specializedCode == "" then
        set runStatus.textContent = "Run unavailable. Compile the program first."
        set runnerOutput.textContent = "Compile the program first to populate the specialized code."
      else
        let combinedCode = MLscript.compile of
          traces:
            codegen: false
          specializedCode + "\n" + runnerEditor.value
        let generatedVars = combinedCode.codegen.vars.trim()
        let generatedCode = combinedCode.codegen.code.trim()
        let compiledCode =
          if generatedVars != "" && generatedCode != "" then generatedVars + "\n\n" + generatedCode
          else generatedVars + generatedCode
        console.log(compiledCode)
        let result = globalThis.eval(compiledCode.replaceAll("runtime", "Runtime")) // FIXME
        // console.log(result)
        set runnerOutput.textContent = result
        set runStatus.textContent = "Run succeeded. The return value is shown below."
    error =>
      set runStatus.textContent = "Run failed. See the runtime output below."
      set runnerOutput.textContent = formatError(error)

let indentRegex = new RegExp("""^(\s*)""")

fun parseIndentedText(text) =
  let root = (text: "", children: mut [])
  let stack = mut [(node: root, indent: -1)]
  text.split("\n")
    Iter.filtering(line => line.trim().length > 0)
    Iter.each of line =>
      let indent = line.match(indentRegex).[1].length
      let text = line.substring(indent)
      while indent <= stack.[stack.length - 1].indent do
        stack.pop()
      let newNode = (text: text, children: mut [])
      stack.[stack.length - 1].node.children.push of newNode
      stack.push of node: newNode, indent: indent
  root.children

// * CSS styles for the error display.
// * The content in custom elements is placed inside the ShadowDOM, which is
// * scoped. Therefore, styles placed directly in HTML won't be effective on
// * elements inside custom elements. Placing CSS here is more convenient.
let errorDisplayStyle = """
.error-container {
  background-color: #fdd;
  padding: 0.375rem 0.75rem 0.5rem;
  font-family: var(--monospace);
  color: #991b1bff;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.error-message {
  margin: 0;
  font-weight: bold;
  font-size: 1.125rem;
}
.stack-trace {
  font-size: 0.875rem;
  margin: 0;
  list-style-type: none;
  padding-left: 0.5rem;
}"""

class CollapsibleTree extends HTMLElement with
  fun connectedCallback() =
    let rawText = this.textContent
    set this.textContent = ""
    let treeData = parseIndentedText(rawText)
    let treeElement = createDetailsTree(treeData, 0)
    this.appendChild(treeElement)
  
  fun createDetailsTree(nodes, depth) =
    let fragment = document.createDocumentFragment()
    nodes Iter.each of node =>
      let details = document.createElement("details")
      if depth < 4 do details.setAttribute("open", "")
      let summary = document.createElement("summary")
      set summary.textContent = node.text
      details.appendChild of summary
      if node.children.length > 0 then
        details.appendChild of createDetailsTree(node.children, depth + 1)
      else
        details.setAttribute("leaf" ,"")
      fragment.appendChild of details
      let rule = document.createElement("rule")
      rule.classList.add("rule")
      fragment.appendChild of rule
    fragment

customElements.define of "collapsible-tree", CollapsibleTree

class ErrorDisplay extends HTMLElement with
  this.attachShadow(mode: "open")
  
  let _error = None
  
  fun connectedCallback() = this.render()
  
  fun setError(value) =
    set _error = Some(value)
    this.render()
  
  fun render() = if _error is Some(error) do
    let stackLines = error.stack.split("\n")
    if stackLines.[0].startsWith(error.name) do
      stackLines.shift()
    set this.shadowRoot.innerHTML = elem("div", "class": "error-container") of
      elem("h3", "class": "error-message") of
        error.name + ": " + error.message
      elem("ul", "class": "stack-trace") of
        stackLines
          Iter.mapping of line => elem("li") of line.trim()
          Iter.joined("")
      elem("style") of errorDisplayStyle

customElements.define of "error-display", ErrorDisplay
